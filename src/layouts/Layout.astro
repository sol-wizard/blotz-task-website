---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/kit.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  alternateLocales?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteUrl = 'https://www.blotztask.com';
const {
  title,
  description = 'BlotzTask is an ADHD-friendly task management app that helps you capture tasks, break work into clear steps, manage deadlines, and plan with less overwhelm.',
  image = '/og-image.svg',
  noindex = false,
  alternateLocales = true,
  jsonLd,
} = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteUrl).toString();
const alternateBasePath = currentPath.replace(/^\/(en|zh)(?=\/|$)/, '') || '/';
const enUrl = new URL(`/en${alternateBasePath === '/' ? '/' : alternateBasePath}`, siteUrl).toString();
const zhUrl = new URL(`/zh${alternateBasePath === '/' ? '/' : alternateBasePath}`, siteUrl).toString();
const xDefaultUrl = currentPath === '/' ? new URL('/', siteUrl).toString() : enUrl;
const imageUrl = new URL(image, siteUrl).toString();
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const alternateLocale = locale === 'zh' ? 'en_US' : 'zh_CN';
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="yQ1_GW7zA0g_aJ_XNf3KYzcFvOI3fjsLQixYayV3l6g" />
  <meta name="google-site-verification" content="7OKvQValAIA6qqumN1dPJPHCCG7Gxzelj0JqB1BEEjA" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonicalUrl} />
  {alternateLocales && <link rel="alternate" hreflang="en" href={enUrl} />}
  {alternateLocales && <link rel="alternate" hreflang="zh" href={zhUrl} />}
  {alternateLocales && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="BlotzTask" />
  <meta property="og:locale" content={ogLocale} />
  {alternateLocales && <meta property="og:locale:alternate" content={alternateLocale} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content="BlotzTask ADHD-friendly task management app preview" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <link rel="icon" type="image/png" href="/app/icon.png" />
  <link rel="apple-touch-icon" href="/app/icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <Nav />
  <slot />
  <Footer />
  <script>
    // Reveal: anything marked .reveal fades in the first time it is seen.
    const items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          seen.unobserve(entry.target);
        });
      }, { threshold: 0.15 });
      items.forEach((item) => seen.observe(item));
    } else {
      items.forEach((item) => item.classList.add('in'));
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --green: #9ad513;
    --blue: #3486F3;
    --green-light: #eef8d2;
    --blue-light: #D5E9FF;
    --bg: #fbfdf7;
    --text: #1E2140;
    --radius: 20px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: ui-rounded, 'SF Pro Rounded', 'Nunito', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  button, input { font-family: inherit; }
  /* Soft band behind the header of the pages that still use it (privacy, guides) */
  .hero-area { background: #eef8d2; overflow: hidden; }
  .blob { display: none; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
