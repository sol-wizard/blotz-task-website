---
import { Icon } from 'astro-icon/components';
import Bun from './Bun.astro';
import { ui, defaultLocale } from '../i18n/landing';
import type { Lang, TranslationKey } from '../i18n/landing';

const locale = (Astro.currentLocale ?? defaultLocale) as Lang;
const t = (key: TranslationKey): string =>
  (ui[locale] as typeof ui[typeof defaultLocale])[key] ?? ui[defaultLocale][key];
---

<footer class="site-footer">
  <!-- a white card with the buns sitting on its top edge -->
  <div class="footer-card">
    <div class="footer-buns" aria-hidden="true">
      <Bun face="plain" class="fb fb-lime" />
      <Bun face="smile" tone="sky" class="fb fb-sky" />
      <Bun face="wink" tone="pink" class="fb fb-pink" />
      <Bun face="sleepy" tone="lilac" class="fb fb-lilac" />
    </div>

    <div class="footer-inner">
      <div class="footer-brand">
        <a class="footer-logo-link" href={`/${locale}/`}>
          <img class="footer-logo-icon" src="/app/icon.png" alt="" width="44" height="44" loading="lazy" />
          BlotzTask
        </a>
        <p class="footer-tagline">{locale === 'zh' ? '让复杂，变简单' : 'AI life planner app'}</p>
        <a class="k-btn is-lime footer-feedback-btn" href={`/${locale}/feedback`}>
          <Icon name="lucide:message-square-heart" width={18} height={18} />
          {t('feedback-btn-label')}
        </a>
      </div>

      <div class="footer-col footer-explore">
        <h4 class="footer-tag is-lime">{t('footer-explore')}</h4>
        <a class="footer-link" href={`/${locale}/#features`}>{t('nav-made-for')}</a>
        <a class="footer-link" href={`/${locale}/roadmap`}>{t('nav-roadmap')}</a>
        <a class="footer-link" href={`/${locale}/about`}>{t('nav-about')}</a>
        <a class="footer-link" href={`/${locale}/join`}>{t('nav-join')}</a>
        <a class="footer-link" href={`/${locale}/fans`}>{locale === 'zh' ? '粉丝团' : 'Fan group'}</a>
      </div>

      <div class="footer-col">
        <h4 class="footer-tag is-sky">{t('footer-resources')}</h4>
        <a class="footer-link" href={`/${locale}/sponsor`}>{t('nav-sponsor')}</a>
        <a class="footer-link" href={`/${locale}/privacy`}>{t('footer-privacy')}</a>
      </div>

      <div class="footer-col">
        <h4 class="footer-tag is-pink">{t('footer-follow')}</h4>
        <a class="footer-link"
          href="https://www.xiaohongshu.com/user/profile/67bc12d6000000000e01f09a"
          target="_blank" rel="noopener noreferrer">
          <span class="footer-social is-red"><Icon name="simple-icons:xiaohongshu" width={16} height={16} /></span>
          Red Note
        </a>
        <a class="footer-link"
          href="https://www.instagram.com/blotztask.app/"
          target="_blank" rel="noopener noreferrer">
          <span class="footer-social is-purple"><Icon name="simple-icons:instagram" width={15} height={15} /></span>
          Instagram
        </a>
        <a class="footer-link"
          href="https://www.linkedin.com/company/blotz-app/"
          target="_blank" rel="noopener noreferrer">
          <span class="footer-social is-blue"><Icon name="lucide:linkedin" width={15} height={15} /></span>
          LinkedIn
        </a>
      </div>
    </div>
  </div>
  <p class="footer-bottom">{t('footer-copy')}</p>
</footer>

<style>
  .site-footer { background: var(--lime-soft); padding: 5.5rem 1.5rem 1.6rem; border-top: 2px solid var(--ink); }
  .footer-card {
    position: relative; max-width: var(--wrap); margin: 0 auto;
    border-radius: 28px; border: 2px solid var(--ink); background: #fff; box-shadow: 0 6px 0 0 var(--ink);
  }

  /* four buns sitting on the top edge of the card */
  .footer-buns { position: absolute; right: 2.5rem; bottom: 100%; display: flex; align-items: flex-end; gap: 0.35rem; margin-bottom: -10px; pointer-events: none; }
  .footer-buns :global(.fb) { height: auto; }
  .footer-buns :global(.fb-lime) { width: 72px; transform: rotate(-6deg); }
  .footer-buns :global(.fb-sky) { width: 54px; transform: rotate(5deg); }
  .footer-buns :global(.fb-pink) { width: 60px; transform: rotate(-4deg); }
  .footer-buns :global(.fb-lilac) { width: 46px; transform: rotate(8deg); }

  .footer-inner {
    padding: 2.6rem 3rem 2.4rem;
    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; align-items: start;
  }
  .footer-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .footer-logo-link { display: flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; font-size: 1.5rem; font-weight: 900; }
  .footer-logo-icon { display: block; width: 44px; height: 44px; border-radius: 12px; border: 2px solid var(--ink); background: #fff; }
  .footer-tagline { color: var(--muted); font-size: 1.05rem; font-weight: 700; }
  .footer-feedback-btn { font-size: 1rem; padding: 0.65rem 1.2rem; margin-top: 0.3rem; }

  .footer-col { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  .footer-tag {
    display: inline-block; margin-bottom: 0.35rem; padding: 0.2rem 0.8rem; border-radius: 999px;
    border: 2px solid var(--ink); font-size: 0.9rem; font-weight: 900; line-height: 1.5; color: var(--ink);
    transform: rotate(-2deg);
  }
  .footer-tag.is-lime { background: var(--lime); }
  .footer-tag.is-sky { background: #bfe3f8; transform: rotate(2deg); }
  .footer-tag.is-pink { background: #fcc7e0; }
  .footer-link { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink); font-size: 1.04rem; font-weight: 800; text-decoration: none; border-radius: 6px; }
  .footer-link:hover { color: var(--lime-deep); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .footer-social { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; border: 2px solid var(--ink); color: #fff; }
  .footer-social.is-red { background: #ff2442; }
  .footer-social.is-purple { background: var(--purple); }
  .footer-social.is-blue { background: #2f7fd6; }
  .footer-link:focus-visible, .footer-logo-link:focus-visible { outline: 3px solid var(--purple); outline-offset: 3px; }

  .footer-bottom { max-width: var(--wrap); margin: 1.6rem auto 0; text-align: center; color: var(--muted); font-size: 0.92rem; font-weight: 600; }

  @media (max-width: 1100px) { .footer-inner { padding: 2.4rem 2rem 2.2rem; gap: 2rem; } }
  @media (max-width: 900px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .site-footer { padding: 4.5rem 1rem 1.4rem; }
    .footer-card { border-radius: 24px; }
    .footer-inner { grid-template-columns: 1fr 1fr; padding: 1.8rem 1.4rem; gap: 1.8rem 1.2rem; }
    .footer-brand { grid-column: 1 / -1; }
    /* Explore is the long list: it takes the left column, the two short lists stack on the right */
    .footer-explore { grid-row: span 2; }
    .footer-buns { right: 1.2rem; }
    .footer-buns :global(.fb-lime) { width: 56px; }
    .footer-buns :global(.fb-sky) { width: 42px; }
    .footer-buns :global(.fb-pink) { width: 46px; }
    .footer-buns :global(.fb-lilac) { width: 36px; }
  }
</style>
