---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale } from '../i18n/landing';
import Bun from './Bun.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const zh = locale === 'zh';
const contactEmail = 'blotztask.app@gmail.com';
const appStoreUrl = 'https://apps.apple.com/au/app/blotztask-adhd-time-manager/id6752492404';
const googlePlayUrl = 'https://play.google.com/store/apps/details?id=com.blotz.blotztask&hl=en';
const reviewUrl = `${appStoreUrl}?action=write-review`;
// every feedback button on the site lands on the same page
const feedbackUrl = `/${locale}/feedback`;
const fansUrl = `/${locale}/fans`;
// Screenshot of the app's Support Us screen for the tip level, e.g. '/app/support-us.jpg'. While empty, the card has no picture.
const tipShot = '/app/support-us.jpg';

type Btn = { label: string; href: string; icon: string; tone?: string; external?: boolean };
type Level = { id: string; tag: string; tagTone: string; title: string; body: string; note?: string; btns: Btn[]; link?: { label: string; href: string } };

// Words for this page. Text inside [ ] gets the highlighter.
// The tip wording follows the app: Settings → Support Us is shown on iPhone only (blotztask-mobile, settings-screen.tsx).
const c = zh
  ? {
      seoTitle: '支持我们 | BlotzTask',
      seoDesc: '想支持 BlotzTask，可以关注我们、下载 App、去商店写评价、提反馈、在 App 里打赏，或者发邮件聊赞助。',
      sticker: '支持我们',
      title: '喜欢我们做的东西，大家都可以[出一份力]',
      sub: '一个点赞，对我们都是很大的鼓励。',
      sponsorJump: '想聊赞助合作？直接找我们',
      meterLabel: '包子的干劲',
      youAre: '你现在是',
      titles: ['路过的朋友', '包子的点头之交', '包子的朋友', '包子的老朋友', '包子的饭搭子', '包子的家里人'],
      freeDone: '四件免费的都做了，谢谢你！',
      allDone: '五件都做了，包子干劲满满。谢谢你！',
      reset: '重新来',
      waysTitle: '能帮上忙的[五件事]',
      waysSub: '不用按顺序，做完一件，打个勾。',
      markDone: '做完了？点这里打勾',
      marked: '做过了',
      bonusTitle: '还想再多帮一点？',
      bonusBody: '还有一件：赞助我们。',
      bonusLink: '看看赞助怎么聊',
      sponsorSticker: '要聊一聊',
      sponsorTitle: '想聊[赞助合作？]',
      sponsorTitleFull: '你已经是包子的家里人了，[还想再多帮一点？]',
      sponsorBody: '赞助会用在 AI 功能、产品开发和社区上。怎么合作，聊了再定。',
      sponsorAsk: '发邮件到 [email]，说说你的想法。',
      sponsorCta: '发邮件联系我们',
      shotAlt: 'App 里的「支持我们」页面',
    }
  : {
      seoTitle: 'Support us | BlotzTask',
      seoDesc: 'Ways to support BlotzTask: follow us, get the app, review it in the store, send feedback, leave a tip in the app, or email us about sponsoring.',
      sticker: 'Support us',
      title: 'Like what we make? Everyone can [pitch in]',
      sub: 'Even one like means a lot to us.',
      sponsorJump: 'Here about sponsoring? Go straight to it',
      meterLabel: 'How motivated the bun is',
      youAre: 'You are now',
      titles: ['Just passing by', 'On nodding terms with the bun', 'Friend of the bun', 'Old friend of the bun', 'The bun’s lunch buddy', 'One of the bun’s family'],
      freeDone: 'All four free ones done. Thank you!',
      allDone: 'All five done. The bun is fired up. Thank you!',
      reset: 'Start over',
      waysTitle: 'Five things [that help]',
      waysSub: 'Any order. Tick each one when it is done.',
      markDone: 'Done it? Tick here',
      marked: 'Done',
      bonusTitle: 'Want to help a bit more?',
      bonusBody: 'One more: sponsor us.',
      bonusLink: 'How sponsoring works',
      sponsorSticker: 'Needs a chat',
      sponsorTitle: 'Here to [sponsor us?]',
      sponsorTitleFull: 'You are one of the bun’s family now. [Want to do more?]',
      sponsorBody: 'Sponsorship goes into AI features, product work and the community. We work out the details together.',
      sponsorAsk: 'Email [email] and tell us what you are thinking.',
      sponsorCta: 'Email us',
      shotAlt: 'The Support Us screen in the app',
    };

// The ladder, easiest first. The first four cost nothing; the tip is the top of it.
const levels: Level[] = zh
  ? [
      {
        id: 'follow', tag: '不花钱', tagTone: 'is-white', title: '点个赞，关注我们',
        body: '看到喜欢的，点个赞。',
        btns: [
          { label: '小红书', href: 'https://www.xiaohongshu.com/user/profile/67bc12d6000000000e01f09a', icon: 'simple-icons:xiaohongshu', tone: 'is-coral', external: true },
          { label: 'Instagram', href: 'https://www.instagram.com/blotztask.app/', icon: 'simple-icons:instagram', external: true },
          { label: 'LinkedIn', href: 'https://www.linkedin.com/company/blotz-app/', icon: 'lucide:linkedin', tone: 'is-blue', external: true },
        ],
      },
      {
        id: 'app', tag: '不花钱', tagTone: 'is-white', title: '下载 App，进粉丝团',
        body: '免费下载。用得顺手，来粉丝团玩。',
        btns: [
          { label: 'App Store', href: appStoreUrl, icon: 'simple-icons:apple', tone: 'is-ink', external: true },
          { label: 'Google Play', href: googlePlayUrl, icon: 'simple-icons:googleplay', external: true },
        ],
        link: { label: '粉丝团怎么进', href: fansUrl },
      },
      {
        id: 'review', tag: '不花钱', tagTone: 'is-white', title: '去商店打个五星',
        body: '新用户下载前，会先看评分。',
        btns: [
          { label: 'App Store 写评价', href: reviewUrl, icon: 'simple-icons:apple', tone: 'is-ink', external: true },
          { label: 'Google Play 写评价', href: googlePlayUrl, icon: 'simple-icons:googleplay', external: true },
        ],
      },
      {
        id: 'feedback', tag: '不花钱', tagTone: 'is-white', title: '告诉我们哪里不好用',
        body: '哪里不好用、想要什么，告诉我们。',
        btns: [{ label: '提交反馈', href: feedbackUrl, icon: 'lucide:message-square-heart', tone: 'is-lime' }],
        link: { label: '去粉丝团说', href: fansUrl },
      },
      {
        id: 'tip', tag: '想给再给', tagTone: 'is-yellow', title: '在 App 里打赏',
        body: 'iPhone：设置 → 支持我们。一次性，不解锁功能。',
        note: '还没看到？等下次更新。安卓暂时没有。',
        btns: [],
      },
    ]
  : [
      {
        id: 'follow', tag: 'Free', tagTone: 'is-white', title: 'Like our posts and follow us',
        body: 'Like something you enjoy.',
        btns: [
          { label: 'Red Note', href: 'https://www.xiaohongshu.com/user/profile/67bc12d6000000000e01f09a', icon: 'simple-icons:xiaohongshu', tone: 'is-coral', external: true },
          { label: 'Instagram', href: 'https://www.instagram.com/blotztask.app/', icon: 'simple-icons:instagram', external: true },
          { label: 'LinkedIn', href: 'https://www.linkedin.com/company/blotz-app/', icon: 'lucide:linkedin', tone: 'is-blue', external: true },
        ],
      },
      {
        id: 'app', tag: 'Free', tagTone: 'is-white', title: 'Get the app and join the fan group',
        body: 'Free to download. If you like it, join the fan group.',
        btns: [
          { label: 'App Store', href: appStoreUrl, icon: 'simple-icons:apple', tone: 'is-ink', external: true },
          { label: 'Google Play', href: googlePlayUrl, icon: 'simple-icons:googleplay', external: true },
        ],
        link: { label: 'How to join the fan group', href: fansUrl },
      },
      {
        id: 'review', tag: 'Free', tagTone: 'is-white', title: 'Give us five stars in the store',
        body: 'New users check the rating before they download.',
        btns: [
          { label: 'Review on App Store', href: reviewUrl, icon: 'simple-icons:apple', tone: 'is-ink', external: true },
          { label: 'Review on Google Play', href: googlePlayUrl, icon: 'simple-icons:googleplay', external: true },
        ],
      },
      {
        id: 'feedback', tag: 'Free', tagTone: 'is-white', title: 'Tell us what is not working',
        body: 'Tell us what is not working, or what you want.',
        btns: [{ label: 'Share your feedback', href: feedbackUrl, icon: 'lucide:message-square-heart', tone: 'is-lime' }],
        link: { label: 'Say it in the fan group', href: fansUrl },
      },
      {
        id: 'tip', tag: 'Only if you want to', tagTone: 'is-yellow', title: 'Leave a tip in the app',
        body: 'iPhone: Settings → Support Us. One-off, unlocks nothing.',
        note: 'Not there yet? Wait for the next update. Not on Android yet.',
        btns: [],
      },
    ];

const hl = (text: string) => text.split(/\[|\]/);
const [askBefore, askAfter] = c.sponsorAsk.split('[email]');
// The bun's face steps up as levels are ticked. Ordered by how the drawings look, not by file name:
// eyes closed, eyes open, happy arcs, wink, then the one with sparkles.
const faces = ['smile', 'plain', 'happy', 'grin', 'sleepy'] as const;
const total = levels.length;
---

<Layout title={c.seoTitle} description={c.seoDesc}>
  <!-- WHY YOU ARE HERE, AND THE BUN'S METER -->
  <section class="band band-top band-yellow">
    <div class="wrap head">
      <div class="head-text">
        <span class="k-sticker is-yellow">
          <Icon name="lucide:heart-handshake" width={16} height={16} />
          {c.sticker}
        </span>
        <h1 class="k-h1">{hl(c.title).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h1>
        <p class="k-lead">{c.sub}</p>
        <a class="jump" href="#sponsor">
          {c.sponsorJump}
          <Icon name="lucide:arrow-down" width={18} height={18} />
        </a>
      </div>

      <div class="toy" data-toy data-face="0" data-titles={JSON.stringify(c.titles)}>
        <div class="toy-stage">
          <svg class="toy-arc" viewBox="0 0 300 172" role="meter" aria-label={c.meterLabel} aria-valuemin="0" aria-valuemax={total} aria-valuenow="0" data-meter>
            <path class="arc-ink" d="M 30 152 A 120 120 0 0 1 270 152" />
            <path class="arc-track" d="M 30 152 A 120 120 0 0 1 270 152" />
            <path class="arc-fill" d="M 30 152 A 120 120 0 0 1 270 152" pathLength="100" data-fill />
          </svg>
          <div class="toy-bun" data-bun aria-hidden="true">
            {faces.map((face, i) => <Bun face={face} class={`face face-${i}`} />)}
          </div>
        </div>
        <div class="toy-ui">
          <p class="toy-title"><span>{c.youAre}</span><strong data-title>{c.titles[0]}</strong></p>
          <p class="toy-msg" data-msg aria-live="polite" data-free={c.freeDone} data-all={c.allDone} hidden></p>
          <button type="button" class="reset" data-reset hidden>
            <Icon name="lucide:rotate-ccw" width={16} height={16} />
            {c.reset}
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- THE LADDER -->
  <section class="band" id="ways">
    <div class="wrap">
      <div class="ways-head reveal">
        <h2 class="k-h2">{hl(c.waysTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h2>
        <p class="k-lead">{c.waysSub}</p>
      </div>

      <div class="status" data-status data-face="0" aria-hidden="true">
        <span class="status-bun">{faces.map((face, i) => <Bun face={face} class={`face face-${i}`} />)}</span>
        <span class="status-title" data-title>{c.titles[0]}</span>
        <span class="dots">{levels.map(() => <i data-dot />)}</span>
      </div>

      <ol class="ladder" data-ladder>
        {levels.map((lv, i) => (
          <li class:list={['lv', `lv-${lv.id}`, 'reveal']} data-level={lv.id} data-free={lv.id !== 'tip' ? '' : undefined}>
            <span class="token" aria-hidden="true">
              <Bun face="happy" class="token-bun" />
              <span class="token-num">Lv.{i + 1}</span>
              <Icon class="token-check" name="lucide:check" width={34} height={34} />
            </span>
            <div class:list={['lv-card', { 'has-shot': lv.id === 'tip' && Boolean(tipShot) }]}>
              <div class="lv-text">
                <span class:list={['k-sticker', lv.tagTone]}>{lv.tag}</span>
                <h3 class="k-h3">{lv.title}</h3>
                {lv.id === 'review' && (
                  <div class="stars" aria-hidden="true">
                    {[0, 1, 2, 3, 4].map(() => (
                      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.3 1.4 6.3L12 16.8 6.3 20l1.4-6.3L2.9 9.4l6.4-.7z" /></svg>
                    ))}
                  </div>
                )}
                <p>{lv.body}</p>
                {lv.note && <p class="lv-small">{lv.note}</p>}
                {lv.btns.length > 0 && (
                  <div class="k-btn-row">
                    {lv.btns.map((b) => (
                      <a class:list={['k-btn', b.tone]} href={b.href} target={b.external ? '_blank' : undefined} rel={b.external ? 'noopener noreferrer' : undefined}>
                        <Icon name={b.icon} width={20} height={20} />
                        {b.label}
                      </a>
                    ))}
                  </div>
                )}
                {lv.link && (
                  <a class="lv-link" href={lv.link.href}>
                    {lv.link.label}
                    <Icon name="lucide:arrow-right" width={18} height={18} />
                  </a>
                )}
                <button type="button" class="done-btn" data-done aria-pressed="false">
                  <span class="done-box" aria-hidden="true"><Icon class="done-check" name="lucide:check" width={16} height={16} /></span>
                  <span class="when-off">{c.markDone}</span>
                  <span class="when-on">{c.marked}</span>
                </button>
              </div>
              {lv.id === 'tip' && tipShot && (
                <div class="k-phone tip-shot"><img src={tipShot} alt={c.shotAlt} loading="lazy" /></div>
              )}
            </div>
          </li>
        ))}

        <!-- the surprise: stays a closed "?" until all five are ticked, then opens onto the sponsor section -->
        <li class="lv lv-bonus" data-bonus>
          <span class="gift" aria-hidden="true">?</span>
          <div class="bonus-card" data-bonus-card hidden>
            <Bun face="wink" class="bonus-bun" />
            <h3 class="k-h3">{c.bonusTitle}</h3>
            <p>{c.bonusBody}</p>
            <a class="k-btn is-lime" href="#sponsor">
              {c.bonusLink}
              <Icon name="lucide:arrow-down" width={20} height={20} />
            </a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- SPONSORING: always here, whether or not anyone plays -->
  <section class="band band-lime" id="sponsor" data-sponsor>
    <div class="wrap">
      <div class="sponsor reveal">
        <div class="sponsor-text">
          <span class="k-sticker">{c.sponsorSticker}</span>
          <!-- the second heading replaces the first once every level is ticked -->
          <h2 class="k-h2">
            <span class="t-default">{hl(c.sponsorTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</span>
            <span class="t-full" hidden>{hl(c.sponsorTitleFull).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</span>
          </h2>
          <p>{c.sponsorBody}</p>
          <p>{askBefore}<span class="mail">{contactEmail}</span>{askAfter}</p>
        </div>
        <div class="sponsor-side">
          <Bun face="wink" class="sponsor-bun" />
          <a class="k-btn is-lime" href={`mailto:${contactEmail}`}>
            <Icon name="lucide:mail" width={20} height={20} />
            {c.sponsorCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="pops" data-pops aria-hidden="true"></div>
</Layout>

<script>
  // The levels are self-reported. Which ones are ticked is kept in this browser's localStorage and nowhere else.
  const KEY = 'blotz-support-levels';
  const ladder = document.querySelector<HTMLElement>('[data-ladder]');
  const toy = document.querySelector<HTMLElement>('[data-toy]');
  if (ladder && toy) {
    const items = [...ladder.querySelectorAll<HTMLElement>('[data-level]')];
    const ids = items.map((item) => item.dataset.level as string);
    const freeIds = items.filter((item) => item.hasAttribute('data-free')).map((item) => item.dataset.level as string);
    const total = ids.length;
    const titles: string[] = JSON.parse(toy.dataset.titles || '[]');
    const meter = toy.querySelector<SVGElement>('[data-meter]');
    const fill = toy.querySelector<SVGPathElement>('[data-fill]');
    const bun = toy.querySelector<HTMLElement>('[data-bun]');
    const msg = toy.querySelector<HTMLElement>('[data-msg]');
    const reset = toy.querySelector<HTMLButtonElement>('[data-reset]');
    const status = document.querySelector<HTMLElement>('[data-status]');
    const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
    const bonus = ladder.querySelector<HTMLElement>('[data-bonus]');
    const bonusCard = ladder.querySelector<HTMLElement>('[data-bonus-card]');
    const pops = document.querySelector<HTMLElement>('[data-pops]');
    const sponsor = document.querySelector<HTMLElement>('[data-sponsor]');
    const sponsorCard = sponsor?.querySelector<HTMLElement>('.sponsor');
    let cheered = false;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const heart = '<svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
    const star = '<svg viewBox="0 0 24 24"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.3 1.4 6.3L12 16.8 6.3 20l1.4-6.3L2.9 9.4l6.4-.7z"/></svg>';

    let done = new Set<string>();
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '[]');
      if (Array.isArray(saved)) done = new Set(saved.filter((id) => ids.includes(id)));
    } catch { /* private window or blocked storage: start empty */ }

    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify([...done])); } catch { /* nothing to do */ }
    };

    const burst = (from: Element, count: number) => {
      if (still.matches || !pops) return;
      const box = from.getBoundingClientRect();
      for (let i = 0; i < count; i += 1) {
        const el = document.createElement('span');
        el.className = `pop ${i % 2 ? 'is-star' : 'is-heart'}`;
        el.innerHTML = i % 2 ? star : heart;
        el.style.left = `${box.left + box.width / 2}px`;
        el.style.top = `${box.top + box.height / 2}px`;
        el.style.setProperty('--x', `${Math.round(Math.random() * 260 - 130)}px`);
        el.style.setProperty('--y', `${Math.round(-110 - Math.random() * 110)}px`);
        el.style.setProperty('--turn', `${Math.round(Math.random() * 70 - 35)}deg`);
        el.style.setProperty('--size', `${Math.round(22 + Math.random() * 18)}px`);
        el.style.animationDelay = `${i * 45}ms`;
        el.addEventListener('animationend', () => el.remove());
        pops.appendChild(el);
      }
    };

    const render = () => {
      const n = done.size;
      const full = n === total;
      const freeDone = freeIds.every((id) => done.has(id));
      const face = String([0, 1, 2, 2, 3, 4][Math.round((n / total) * 5)] ?? 0);
      items.forEach((item) => {
        const on = done.has(item.dataset.level as string);
        item.classList.toggle('is-done', on);
        item.querySelector('[data-done]')?.setAttribute('aria-pressed', String(on));
      });
      toy.dataset.face = face;
      toy.classList.toggle('is-full', full);
      if (fill) { fill.style.strokeDasharray = `${(n / total) * 100} 100`; fill.style.opacity = n ? '1' : '0'; }
      meter?.setAttribute('aria-valuenow', String(n));
      document.querySelectorAll<HTMLElement>('[data-title]').forEach((el) => { el.textContent = titles[n] ?? titles[0]; });
      if (status) status.dataset.face = face;
      dots.forEach((dot, i) => dot.classList.toggle('on', i < n));
      if (msg) {
        const text = full ? msg.dataset.all : freeDone ? msg.dataset.free : '';
        msg.hidden = !text;
        if (msg.textContent !== text) msg.textContent = text || '';
      }
      if (reset) reset.hidden = n === 0;
      bonus?.classList.toggle('is-open', full);
      if (bonusCard) bonusCard.hidden = !full;
      // the sponsor section is always there; with every level ticked it greets the visitor differently
      if (sponsor) {
        sponsor.toggleAttribute('data-cheer', full);
        sponsor.querySelector<HTMLElement>('.t-default')!.hidden = full;
        sponsor.querySelector<HTMLElement>('.t-full')!.hidden = !full;
        if (!full) cheered = false;
      }
    };

    // the first time the sponsor section is seen after the ladder is full, it celebrates once
    if (sponsor && sponsorCard && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting || cheered || !sponsor.hasAttribute('data-cheer')) return;
        cheered = true;
        burst(sponsorCard, 18);
        const cheerBun = sponsor.querySelector<HTMLElement>('.sponsor-bun');
        if (cheerBun && !still.matches) { cheerBun.classList.remove('cheer'); void cheerBun.getBoundingClientRect(); cheerBun.classList.add('cheer'); }
      }, { threshold: 0.5 }).observe(sponsorCard);
    }

    items.forEach((item) => {
      const id = item.dataset.level as string;
      const button = item.querySelector<HTMLButtonElement>('[data-done]');
      button?.addEventListener('click', () => {
        const hadFree = freeIds.every((f) => done.has(f));
        if (done.has(id)) done.delete(id); else done.add(id);
        save();
        render();
        if (!done.has(id)) return;
        const full = done.size === total;
        const justFree = !hadFree && freeIds.every((f) => done.has(f));
        burst(button, full ? 16 : justFree ? 10 : 5);
        if (full && bonus) window.setTimeout(() => burst(bonus, 10), 350);
        if (bun) { bun.classList.remove('hop'); void bun.offsetWidth; bun.classList.add('hop'); }
      });
    });

    reset?.addEventListener('click', () => {
      done.clear();
      save();
      render();
    });

    render();
  }
</script>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 4rem; align-items: center; }
  .head-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; }
  .jump, .lv-link {
    display: inline-flex; align-items: center; gap: 0.35rem; color: var(--ink); font-size: 1.05rem; font-weight: 900;
    text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 3px; text-underline-offset: 4px;
  }
  .jump:focus-visible, .lv-link:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; border-radius: 6px; }
  #ways, #sponsor { scroll-margin-top: 5rem; }

  /* ── the bun under its meter ── */
  .toy { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; text-align: center; }
  .toy-stage { position: relative; width: min(340px, 100%); }
  .toy-arc { display: block; width: 100%; height: auto; overflow: visible; }
  .toy-arc path { fill: none; stroke-linecap: round; }
  .arc-ink { stroke: var(--ink); stroke-width: 34; }
  .arc-track { stroke: #fff; stroke-width: 26; }
  .arc-fill { stroke: var(--lime); stroke-width: 26; stroke-dasharray: 0 100; opacity: 0; transition: stroke-dasharray 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .toy:global(.is-full) .arc-fill { stroke: var(--coral); }

  .toy-bun { position: absolute; left: 50%; bottom: 0; width: 46%; transform: translateX(-50%) rotate(-4deg); transform-origin: 50% 100%; }
  .toy-bun :global(.face), .status-bun :global(.face) { display: none; width: 100%; height: auto; }
  [data-face='0'] :global(.face-0), [data-face='1'] :global(.face-1), [data-face='2'] :global(.face-2),
  [data-face='3'] :global(.face-3), [data-face='4'] :global(.face-4) { display: block; }
  .toy-bun:global(.hop) { animation: hop 0.4s ease-out; }
  @keyframes hop {
    0% { transform: translateX(-50%) rotate(-4deg) scale(1, 1); }
    35% { transform: translateX(-50%) translateY(-14px) rotate(3deg) scale(0.96, 1.06); }
    70% { transform: translateX(-50%) rotate(-4deg) scale(1.06, 0.94); }
    100% { transform: translateX(-50%) rotate(-4deg) scale(1, 1); }
  }

  .toy-ui { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  .toy-title {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.2rem 0.6rem;
    padding: 0.55rem 1.5rem; border-radius: 999px; border: 2px solid var(--ink); background: #fff; box-shadow: 0 4px 0 0 var(--ink);
    color: var(--muted); font-weight: 800; transform: rotate(-1.5deg);
  }
  .toy-title strong { color: var(--ink); font-size: 1.25rem; font-weight: 900; }
  .toy-msg { color: var(--ink); font-size: 1.1rem; font-weight: 800; line-height: 1.6; }
  .toy-msg[hidden], .reset[hidden], .bonus-card[hidden] { display: none; }
  .reset {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 1rem; border-radius: 999px; border: 2px solid var(--ink);
    background: transparent; color: var(--ink); font: inherit; font-size: 0.95rem; font-weight: 800; cursor: pointer;
  }
  .reset:hover { background: #fff; }
  .reset:focus-visible, .done-btn:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }

  /* Without JavaScript nothing can be ticked, so the game parts go and a plain list of ways is left. */
  :global(html:not(.js)) .toy-arc, :global(html:not(.js)) .toy-ui, :global(html:not(.js)) .status,
  :global(html:not(.js)) .done-btn, :global(html:not(.js)) .lv-bonus { display: none; }
  :global(html:not(.js)) .lv-tip { grid-column: 1 / -1; width: min(100%, 720px); margin-inline: auto; }
  :global(html:not(.js)) .toy-bun { position: static; width: 180px; transform: rotate(-4deg); }
  :global(html:not(.js)) .toy :global(.face-0) { display: none; }
  :global(html:not(.js)) .toy :global(.face-2) { display: block; }

  /* ── where you are, kept in view while the ladder scrolls ── */
  .ways-head { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .status {
    position: sticky; top: 5.6rem; z-index: 5; display: flex; align-items: center; gap: 0.8rem; width: fit-content; max-width: 100%;
    margin: 2rem auto 0; padding: 0.4rem 1.2rem 0.4rem 0.6rem; border-radius: 999px; border: 2px solid var(--ink); background: #fff; box-shadow: 0 4px 0 0 var(--ink);
  }
  .status-bun { width: 40px; flex: 0 0 40px; }
  .status-title { font-weight: 900; color: var(--ink); }
  .dots { display: flex; gap: 0.3rem; }
  .dots i { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--ink); background: #fff; transition: background 0.2s ease, transform 0.2s ease; }
  .dots :global(i.on) { background: var(--lime); transform: scale(1.15); }
  .dots i:last-child:global(.on) { background: var(--coral); }

  /* ── the ladder: cards step left and right of a dashed path, each with a round level token on the path ── */
  .ladder { position: relative; list-style: none; display: grid; grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); row-gap: 2.5rem; margin-top: 3.5rem; align-items: start; }
  .ladder::before { content: ''; position: absolute; left: 50%; top: 3rem; bottom: 5rem; border-left: 4px dashed var(--ink); opacity: 0.25; translate: -2px 0; }
  .lv { position: relative; min-width: 0; }
  .lv:nth-child(odd) { grid-column: 1; }
  .lv:nth-child(even) { grid-column: 3; margin-top: 8rem; }
  .lv:nth-child(1), .lv:nth-child(2) { grid-row: 1; }
  .lv:nth-child(3), .lv:nth-child(4) { grid-row: 2; }
  .lv:nth-child(5), .lv:nth-child(6) { grid-row: 3; }

  .token {
    position: absolute; top: 2.4rem; z-index: 2; display: grid; place-items: center; width: 78px; height: 78px; border-radius: 50%;
    border: 2px solid var(--ink); background: #fff; box-shadow: 0 4px 0 0 var(--ink); color: var(--ink); font-size: 1.15rem; font-weight: 900;
    transition: background 0.2s ease;
  }
  .lv:nth-child(odd) .token { right: -99px; rotate: -5deg; }
  /* the right-hand tokens sit lower on their card, so the tokens are spread evenly down the path instead of in pairs */
  .lv:nth-child(even) .token { left: -99px; top: 46%; rotate: 5deg; }
  .token :global(.token-check) { display: none; }
  .token :global(.token-bun) { position: absolute; left: 50%; bottom: 82%; width: 46px; translate: -50% 0; display: none; }
  .lv:global(.is-done) .token { background: var(--lime); }
  .lv:global(.is-done) .token-num { display: none; }
  .lv:global(.is-done) .token :global(.token-check) { display: block; }
  .lv:global(.is-done) .token :global(.token-bun) { display: block; animation: pop-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pop-in { from { transform: scale(0.3) translateY(20px); } to { transform: none; } }

  .lv-card { display: flex; padding: 2.2rem 2.2rem 2.4rem; border: 2px solid var(--ink); box-shadow: 0 6px 0 0 var(--ink); color: var(--ink); }
  .lv-card.has-shot { align-items: center; gap: 2rem; }
  .lv-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; min-width: 0; flex: 1; }
  .lv-card p { color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .lv-card .lv-small { font-size: 0.98rem; }
  .lv-card .k-h3 { font-size: 1.6rem; }
  .tip-shot { width: 210px; flex: 0 0 210px; rotate: 4deg; }
  .lv-follow .lv-card { background: var(--blue-soft); border-radius: 56px 36px 60px 40px / 44px 56px 40px 60px; rotate: -0.7deg; }
  .lv-app .lv-card { background: var(--lime-soft); border-radius: 40px 60px 38px 58px / 58px 40px 60px 42px; rotate: 0.9deg; }
  .lv-review .lv-card { background: var(--yellow-soft); border-radius: 60px 42px 54px 36px / 40px 58px 44px 60px; rotate: 0.6deg; }
  .lv-feedback .lv-card { background: var(--purple-soft); border-radius: 42px 58px 36px 60px / 56px 38px 60px 42px; rotate: -0.6deg; }
  .lv-tip .lv-card { background: #fff; border-radius: 58px 40px 62px 38px / 42px 60px 38px 56px; rotate: 0.5deg; }
  .stars { display: flex; gap: 0.3rem; color: var(--ink); rotate: -2deg; }
  .stars svg { fill: var(--yellow); stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }
  .stars svg:nth-child(even) { translate: 0 -4px; }

  /* looks like a real button with an empty tick box, so it is clear it can be pressed */
  .done-btn {
    display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 0.3rem; padding: 0.5rem 1.2rem 0.5rem 0.6rem; border-radius: 999px;
    border: 2px solid var(--ink); background: var(--yellow-soft); color: var(--ink); box-shadow: 0 4px 0 0 var(--ink);
    font: inherit; font-size: 1.02rem; font-weight: 900; cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .done-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 0 0 var(--ink); }
  .done-btn:active { transform: translateY(3px); box-shadow: 0 1px 0 0 var(--ink); }
  .done-box { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; border: 2px solid var(--ink); background: #fff; }
  .done-btn:hover .done-box { background: var(--lime-soft); }
  .done-btn :global(.done-check), .done-btn .when-on { display: none; }
  .done-btn[aria-pressed='true'] { background: var(--lime); box-shadow: 0 3px 0 0 var(--ink); }
  .done-btn[aria-pressed='true'] .done-box { background: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .done-btn[aria-pressed='false'] .done-box { animation: box-wiggle 2.8s ease-in-out infinite; }
  }
  @keyframes box-wiggle { 0%, 82%, 100% { rotate: 0deg; } 88% { rotate: -12deg; } 94% { rotate: 10deg; } }
  .done-btn[aria-pressed='true'] :global(.done-check), .done-btn[aria-pressed='true'] .when-on { display: inline; }
  .done-btn[aria-pressed='true'] .when-off { display: none; }

  /* ── the surprise at the end of the path ── */
  .lv-bonus { display: grid; place-items: center; min-height: 220px; }
  .gift {
    display: grid; place-items: center; width: 150px; height: 150px; border-radius: 46% 54% 50% 50% / 55% 48% 52% 45%;
    border: 3px dashed var(--ink); color: var(--ink); font-size: 4rem; font-weight: 900; opacity: 0.3; rotate: 8deg;
  }
  .lv-bonus:global(.is-open) .gift { display: none; }
  .bonus-card {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; width: 100%; padding: 2.6rem 2.2rem 2.2rem;
    border-radius: 60px 44px 56px 40px / 46px 60px 42px 58px; border: 2px solid var(--ink); background: var(--ink); box-shadow: 0 6px 0 0 var(--lime-deep);
    rotate: -1.2deg; animation: unfold 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .bonus-card .k-h3 { color: #fff; font-size: 1.6rem; }
  .bonus-card .k-btn { max-width: 100%; white-space: normal; }
  .bonus-card p { color: rgba(255, 255, 255, 0.82); font-size: 1.1rem; line-height: 1.7; }
  .bonus-card :global(.bonus-bun) { position: absolute; top: -44px; right: 2.2rem; width: 92px; transform: rotate(10deg); }
  @keyframes unfold { from { opacity: 0; transform: scale(0.5) rotate(-8deg); } to { opacity: 1; transform: none; } }

  /* ── sponsoring ── */
  .sponsor {
    display: flex; align-items: center; gap: 3rem; padding: 3rem 3.2rem; border: 2px solid var(--ink); background: var(--ink);
    border-radius: 70px 48px 76px 52px / 52px 72px 48px 70px; box-shadow: 0 7px 0 0 var(--lime-deep); rotate: -0.4deg;
  }
  .sponsor-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; flex: 1; min-width: 0; }
  .sponsor .k-h2 { color: #fff; font-size: clamp(1.8rem, 3.2vw, 2.8rem); }
  .sponsor .k-hl { color: var(--ink); background: var(--lime); border-radius: 0.2em; }
  .sponsor p { color: rgba(255, 255, 255, 0.82); font-size: 1.15rem; line-height: 1.7; }
  .mail { color: #fff; font-weight: 800; overflow-wrap: anywhere; }
  .sponsor-side { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }
  .sponsor-side :global(.sponsor-bun) { width: 130px; transform: rotate(-8deg); }
  .sponsor-side :global(.sponsor-bun.cheer) { animation: cheer-hop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 2; }
  @keyframes cheer-hop { 0%, 100% { translate: 0 0; } 40% { translate: 0 -26px; } }
  .t-default[hidden], .t-full[hidden] { display: none; }

  /* ── hearts and stars ── */
  .pops { position: fixed; inset: 0; z-index: 200; pointer-events: none; overflow: hidden; }
  .pops :global(.pop) {
    position: absolute; width: var(--size, 28px); height: var(--size, 28px); margin: calc(var(--size, 28px) / -2) 0 0 calc(var(--size, 28px) / -2);
    opacity: 0; animation: float-up 1.1s ease-out forwards;
  }
  .pops :global(.pop svg) { display: block; width: 100%; height: 100%; stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }
  .pops :global(.pop.is-heart svg) { fill: var(--coral); }
  .pops :global(.pop.is-star svg) { fill: var(--yellow); }
  @keyframes float-up {
    0% { opacity: 0; transform: translate(0, 0) scale(0.4) rotate(0deg); }
    20% { opacity: 1; }
    100% { opacity: 0; transform: translate(var(--x, 0), var(--y, -160px)) scale(1) rotate(var(--turn, 0deg)); }
  }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; gap: 2.5rem; }
    .head-text { align-items: center; text-align: center; }
    .ladder { grid-template-columns: minmax(0, 1fr); row-gap: 3.6rem; margin-top: 3.5rem; }
    .ladder::before { display: none; }
    .lv:nth-child(n) { grid-column: 1; grid-row: auto; margin-top: 0; }
    .lv:nth-child(n) .token { top: -34px; left: auto; right: 1.6rem; width: 68px; height: 68px; font-size: 1.05rem; }
    .lv-card { padding: 2rem 1.5rem 2rem; }
    .lv-card .k-btn-row { justify-content: flex-start; }
    .lv-bonus { min-height: 0; }
    .bonus-card { padding: 2.4rem 1.5rem 2rem; }
    .gift { width: 110px; height: 110px; font-size: 3rem; }
    .sponsor { flex-direction: column; align-items: flex-start; gap: 2rem; padding: 2.4rem 1.8rem; }
    .sponsor-side { flex-direction: row; flex-wrap: wrap; }
    .sponsor-side :global(.sponsor-bun) { width: 84px; }
  }
  @media (max-width: 600px) {
    .lv .lv-card, .bonus-card, .sponsor { rotate: none; border-radius: 36px 28px 38px 30px / 30px 38px 28px 36px; }
    .lv-card.has-shot { flex-direction: column; align-items: flex-start; }
    .tip-shot { align-self: center; }
    .status { top: 5rem; gap: 0.5rem; padding-right: 0.9rem; font-size: 0.95rem; }
    .status-bun { width: 32px; flex-basis: 32px; }
    .dots i { width: 12px; height: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc-fill, .dots i, .token, .done-btn { transition: none; }
    .done-btn:hover { transform: none; }
    .toy-bun:global(.hop), .bonus-card, .lv:global(.is-done) .token :global(.token-bun) { animation: none; }
    .pops :global(.pop) { display: none; animation: none; }
  }
</style>
