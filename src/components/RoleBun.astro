---
// The bun that walks round the loop on /how-we-build, dressed as whoever owns the stage it has reached.
// The two who cook wear chef's hats, a tall one for the Senior and a short one for the Developer; the PM
// is the boss, in sunglasses. Soft gradient body with no outline, like the other buns on the site.
// A hat stands above the picture's own box, so the bun's body stays the same size whoever it is.
interface Props {
  role: string;
  class?: string;
}
const { role, class: className = '' } = Astro.props;

// The mascot's outline and its two smiling eyes, as drawn for the app.
const BODY =
  'M41.1797 16C43.872 16.0001 46.0546 18.1833 46.0547 20.876C46.0547 22.5163 46.1907 24.3737 47.2627 25.6152C50.2142 29.0329 52 33.487 52 38.3574C51.9997 49.1279 43.2692 50.0107 32.5 50.0107C21.7308 50.0107 13.0003 49.1279 13 38.3574C13.0001 27.5865 21.7306 18.8546 32.5 18.8545C34.8428 18.8544 37.1371 17.2823 39.2979 16.377C39.8768 16.1344 40.5127 16 41.1797 16Z';
const EYES =
  'M38.2412 33.0176C36.081 33.0665 33.6986 33.8956 31.7012 36.2607L32.2734 36.7441L32.8467 37.2275C34.5419 35.2202 36.5051 34.5567 38.2754 34.5166C40.0761 34.4758 41.6944 35.0834 42.6094 35.6406L43.3906 34.3594C42.2689 33.6762 40.3706 32.9693 38.2412 33.0176ZM26.1729 35.3105C24.9499 33.6796 21.3404 30.8175 16.7285 32.6533L17.0049 33.3496L17.2832 34.0469C21.0002 32.5672 23.9544 34.8528 24.9727 36.2109L26.1729 35.3105Z';
const TALL_HAT =
  'M-7.8 -5L-8.4 -13.5C-13 -14.5 -13.2 -21.5 -7.6 -21.4C-6.4 -25.6 .6 -26 2.2 -22.6C5.8 -25.4 12.6 -22.4 10.6 -17.2C12 -15.6 10.4 -13.6 8.4 -13.5L7.8 -5Z';
const SHORT_HAT = 'M-7.6 -5C-12.6 -5.6 -12.6 -11.8 -7.2 -11.6C-5.8 -14.8 1.4 -15 2.8 -12.2C7 -14.2 12.6 -9.6 7.6 -5Z';

// [gradient stops], eye colour, shadow under the bun: the same colours as each role's chip
const looks: Record<string, { stops: string[]; eye: string; shade: string }> = {
  Senior: { stops: ['#a48df9', '#d3c6fb'], eye: '#ffffff', shade: 'rgba(98, 71, 179, 0.3)' },
  Developer: { stops: ['#8fd10e', '#cdeb86'], eye: '#ffffff', shade: 'rgba(77, 125, 9, 0.28)' },
  PM: { stops: ['#ffffff', '#e9ecf4'], eye: '#1e2140', shade: 'rgba(30, 33, 64, 0.22)' },
};
const look = looks[role] ?? looks.PM;
const tall = role === 'Senior';
const id = `role-bun-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="10 13 46 44" class:list={['role-bun', className]} style={`filter: drop-shadow(0 3px 0 ${look.shade});`} aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0.2" x2="1" y2="0.8">
      {look.stops.map((color, i) => <stop offset={i / (look.stops.length - 1)} stop-color={color} />)}
    </linearGradient>
  </defs>
  <path d={BODY} style={`fill: url(#${id});`} />
  {role === 'PM' ? (
    <g stroke="#1e2140" stroke-linejoin="round" stroke-linecap="round">
      <path d="M26.6 33.6Q29.2 32.4 31.6 33.9M16.4 32.6L13.9 31.9M43.8 33.9L50.4 32.2" fill="none" stroke-width="1.5" />
      <path d="M16.2 31.6Q21.6 30.2 26.8 32Q27.6 38.4 22.6 39.2Q16.6 39.6 16.2 31.6Z" fill="#1e2140" stroke-width="1.2" />
      <path d="M31.4 32.3Q37.8 30.6 44 32.6Q44.6 39.8 38.6 40.4Q31.6 40.6 31.4 32.3Z" fill="#1e2140" stroke-width="1.2" />
      <path d="M18.6 33.6L21 33.2M34 34.4L37 33.9" fill="none" stroke="#fff" stroke-width="1.1" />
    </g>
  ) : (
    <path d={EYES} fill={look.eye} />
  )}
  {(role === 'Senior' || role === 'Developer') && (
    <g transform="translate(25.4 22.6) rotate(-17)" fill="#fff" stroke="#1e2140" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
      <path d={tall ? TALL_HAT : SHORT_HAT} />
      {tall && <path d="M-3 -6.6V-12.4M2.6 -6.6V-12.4" fill="none" stroke-width="1.2" />}
      <rect x="-9.4" y="-5.4" width="18.8" height="5.6" rx="1.6" />
    </g>
  )}
</svg>

<style>
  .role-bun { display: block; overflow: visible; }
</style>
