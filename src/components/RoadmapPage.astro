---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale } from '../i18n/landing';
import Bun from './Bun.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const zh = locale === 'zh';

// The road ahead, drawn as a hand-drawn game map: nine round stops on a curvy path that snakes down the page.
// The bun stands on the stop we are at today. Stops come from the team's backlog.
// A 'test' stop is already on the public TestFlight, so its card sends visitors to the fan group to try it.
const c = zh
  ? {
      title: '产品[路线图]',
      subtitle: '我们会一点点扩建包子的厨房，做出更好吃的包子。沿着这条路往下走，就是接下来要做的事。',
      here: '我们在这里',
      stops: [
        { state: 'here', icon: 'lucide:map-pin', tag: '现在', title: 'BlotzTask 1.4', desc: '现在可以下载的版本。' },
        { state: 'test', icon: 'lucide:message-circle-heart', tag: '已经在测试', title: 'AI 行动教练', desc: 'AI 会先问清楚你现在的状态，每次只给你一个下一步，确认后可以马上开始专注。' },
        { state: 'now', icon: 'lucide:layout-grid', tag: '正在开发', title: '桌面小组件新样式', desc: '在手机桌面上看到今天的日期，和今天还有几件任务。' },
        { state: 'now', icon: 'lucide:award', tag: '正在开发', title: '徽章可以重复获得', desc: '同一枚徽章可以拿到不止一次。' },
        { state: 'next', icon: 'lucide:gift', tag: '接下来', title: '被邀请的朋友也有徽章', desc: '用邀请码加入的朋友，也会马上拿到一枚徽章。' },
        { state: 'next', icon: 'lucide:users', tag: '接下来', title: '7 天组队打卡', desc: '邀请朋友一起打卡 7 天，所有人每天都打卡，就一起拿到徽章。' },
        { state: 'next', icon: 'lucide:message-square-plus', tag: '接下来', title: '在 App 里提反馈', desc: '不用离开 App，就能匿名发反馈和截图。' },
        { state: 'next', icon: 'lucide:bell-ring', tag: '接下来', title: '更可靠的提醒', desc: '提醒更准时，一件任务可以设多个提醒。' },
        { state: 'later', icon: 'lucide:wifi-off', tag: '计划中', title: '离线使用', desc: '没有网络时也能查看和记录任务。' },
        { state: 'ask', icon: 'lucide:message-square-plus', tag: '下一站由你定', title: '别让包子团队[停下来]', desc: '你来提建议，我们来干活。想要什么功能、哪里不好用，直接告诉我们。' },
      ],
      note: '越往后的内容越可能调整。',
      askBtn: '提建议',
      testBtn: '加入粉丝团试用',
      cta: '下载 BlotzTask',
    }
  : {
      title: 'Product [roadmap]',
      subtitle: 'We are slowly making the bun kitchen bigger so we can make better buns. Follow the trail down the page to see what is coming next.',
      here: 'We are here',
      stops: [
        { state: 'here', icon: 'lucide:map-pin', tag: 'Today', title: 'BlotzTask 1.4', desc: 'The version you can download now.' },
        { state: 'test', icon: 'lucide:message-circle-heart', tag: 'Testing now', title: 'AI action coach', desc: 'AI asks how you are doing first, gives you one next step at a time, and lets you start a focus session as soon as you confirm it.' },
        { state: 'now', icon: 'lucide:layout-grid', tag: 'Building now', title: 'New home-screen widget', desc: "See today's date and how many tasks you have left, right on your home screen." },
        { state: 'now', icon: 'lucide:award', tag: 'Building now', title: 'Badges you can earn again', desc: 'Earn the same badge more than once.' },
        { state: 'next', icon: 'lucide:gift', tag: 'Up next', title: 'A badge for the friend you invite', desc: 'A friend who joins with your invite code gets a badge straight away.' },
        { state: 'next', icon: 'lucide:users', tag: 'Up next', title: '7-day group check-in', desc: 'Invite friends to check in for 7 days. If everyone checks in every day, you all get a badge.' },
        { state: 'next', icon: 'lucide:message-square-plus', tag: 'Up next', title: 'Feedback inside the app', desc: 'Send anonymous feedback with a screenshot without leaving the app.' },
        { state: 'next', icon: 'lucide:bell-ring', tag: 'Up next', title: 'More reliable reminders', desc: 'Reminders that arrive on time, and more than one reminder per task.' },
        { state: 'later', icon: 'lucide:wifi-off', tag: 'Planned', title: 'Offline use', desc: 'View and add tasks without a connection.' },
        { state: 'ask', icon: 'lucide:message-square-plus', tag: 'You pick the next stop', title: 'Keep the Blotz team [busy]', desc: 'You suggest, we build. Tell us what you want next or what isn’t working.' },
      ],
      note: 'The further down the trail, the more likely it is to change.',
      askBtn: 'Make a suggestion',
      testBtn: 'Join the fan group',
      cta: 'Download BlotzTask',
    };

const description = zh
  ? 'BlotzTask 产品路线图：已经在测试的 AI 行动教练、正在开发的小组件新样式，和接下来计划做的功能。'
  : 'The BlotzTask roadmap: the AI action coach in testing, the new widget being built, and what is planned after them.';
// Where each stop sits inside its patch of the map, so the stops do not line up like a table:
// the last one, where visitors suggest what comes next, has a row to itself.
// token position across the patch, how far the patch is pushed down, and the tilt of its bubble.
const spots = [
  { x: 24, dy: 0, tilt: -1.4 }, { x: 52, dy: 54, tilt: 1.1 }, { x: 72, dy: 8, tilt: -0.9 },
  { x: 70, dy: 34, tilt: 1.5 }, { x: 44, dy: -8, tilt: -1.1 }, { x: 28, dy: 40, tilt: 0.9 },
  { x: 30, dy: 10, tilt: -1.3 }, { x: 54, dy: 56, tilt: 1.2 }, { x: 66, dy: 4, tilt: -0.8 },
  { x: 50, dy: 30, tilt: 0 },
];
const stickerTone: Record<string, string> = { here: '', test: '', now: 'is-blue', next: 'is-yellow', later: 'is-white', ask: 'is-purple' };
const plain = (text: string) => text.replace(/\[|\]/g, '');

// The map is also a small game: the bun is the piece and the tokens are buttons. Click a stop and the bun
// hops there along the path. Every stop it lands on gets a star, each stop after the first gives the bun
// something to wear, and the bun grows a little each time. {n}, {total}, {title} and {item} are filled in by the script.
const g = zh
  ? {
      intro: '',
      reset: '回到起点',
      count: '已逛 {n} / {total}',
      at: '第 {n} 站：{title}',
      atGot: '第 {n} 站：{title}。包子拿到了{item}。',
      got: '包子拿到了{item}。',
      endAll: '{total} 站你都逛过了。路还在修，下一站去哪，你来定。',
      endOne: '路还在修，下一站去哪，你来定。还有 {n} 站没逛。',
      endMany: '路还在修，下一站去哪，你来定。还有 {n} 站没逛。',
      goTo: '让包子走到第 {n} 站：{title}',
      visited: '（已逛）',
      poke: '戳一下包子',
      items: ['头带', '小靴子', '奖牌', '围巾', '一个小伙伴', '披风', '星光', '皇冠'],
    }
  : {
      intro: '',
      reset: 'Back to start',
      count: 'Visited {n} / {total}',
      at: 'Stop {n}: {title}',
      atGot: 'Stop {n}: {title}. The bun got {item}.',
      got: 'The bun got {item}. ',
      endAll: 'You visited all {total} stops. The road is still being built, and you pick where it goes next.',
      endOne: 'The road is still being built, and you pick where it goes next. {n} stop left to visit.',
      endMany: 'The road is still being built, and you pick where it goes next. {n} stops left to visit.',
      goTo: 'Move the bun to stop {n}: {title}',
      visited: ' (visited)',
      poke: 'Poke the bun',
      items: ['a headband', 'boots', 'a medal', 'a scarf', 'a little friend', 'a cape', 'sparkles', 'a crown'],
    };
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
---

<Layout title={`${c.title.replace(/\[|\]/g, '')} | BlotzTask`} description={description}>
  <section class="band band-top band-lime">
    <div class="wrap k-page-head">
      <h1 class="k-h1">{c.title.split(/\[|\]/).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h1>
      <p class="k-lead">{c.subtitle}</p>
    </div>
  </section>

  <section class="band band-blue">
    <div class="wrap">
      <div class="board" data-board>
        <svg class="road" aria-hidden="true">
          <path class="road-bed" data-road />
          <path class="road-dots" data-road />
          <path class="road-measure" data-measure />
        </svg>
        <span class="deco cloud cloud-1" aria-hidden="true"><svg viewBox="0 0 96 52"><path d="M22 46a16 16 0 0 1-2-31.800A22 22 0 0 1 61 10a17 17 0 0 1 17 36z" /></svg></span>
        <span class="deco cloud cloud-2" aria-hidden="true"><svg viewBox="0 0 96 52"><path d="M22 46a16 16 0 0 1-2-31.800A22 22 0 0 1 61 10a17 17 0 0 1 17 36z" /></svg></span>
        <span class="deco cloud cloud-3" aria-hidden="true"><svg viewBox="0 0 96 52"><path d="M22 46a16 16 0 0 1-2-31.800A22 22 0 0 1 61 10a17 17 0 0 1 17 36z" /></svg></span>
        <span class="deco spark spark-1" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1q0 11 11 11q-11 0-11 11q0-11-11-11q11 0 11-11z" /></svg></span>
        <span class="deco spark spark-2" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1q0 11 11 11q-11 0-11 11q0-11-11-11q11 0 11-11z" /></svg></span>
        <span class="deco spark spark-3" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1q0 11 11 11q-11 0-11 11q0-11-11-11q11 0 11-11z" /></svg></span>
        <span class="deco spark spark-4" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1q0 11 11 11q-11 0-11 11q0-11-11-11q11 0 11-11z" /></svg></span>
        <ol class="map" data-map>
          {c.stops.map((stop, i) => (
            <li
              class:list={['stop', `stop-${i + 1}`, `is-${stop.state}`, i === 0 && 'is-current is-visited']}
              style={`--x:${spots[i].x}%;--dy:${spots[i].dy}px;--tilt:${spots[i].tilt}deg`}
              data-stop
              data-title={plain(stop.title)}
            >
              <div class="stop-node">
                {stop.state === 'here' && (
                  <>
                    <span class="here-flag k-sticker is-yellow is-flat">{c.here}</span>
                  <button type="button" class="stop-bun" data-bun aria-label={g.poke} disabled>
                    <span class="bun-fig">
                      <svg class="gear" viewBox="11 14 43 38" aria-hidden="true">
                        <path data-gear="7" class="g-purple" d="M24 22C12 25 5 38 3 54l8-4 6 4 7-4z" />
                      </svg>
                      <Bun class="bun-idle" />
                      <Bun face="grin" class="bun-win" />
                      <Bun face="wink" class="bun-poke" />
                      <svg class="gear" viewBox="11 14 43 38" aria-hidden="true">
                        <g data-gear="3" class="g-ink">
                          <rect x="20.5" y="48.6" width="9.5" height="5" rx="2.5" />
                          <rect x="35" y="48.6" width="9.5" height="5" rx="2.5" />
                        </g>
                        <g data-gear="5" class="g-coral">
                          <path d="M43 45.4l4.2-.6 1 7.4-4.6.3z" />
                          <path d="M13.7 40.8q18.8 4.4 37.6 0l.4 3.7q-19.2 4.6-38.4 0z" />
                        </g>
                        <g data-gear="4">
                          <path class="g-blue" d="M20.6 41.6h4.8L23 46z" />
                          <circle class="g-yellow" cx="23" cy="47.4" r="2.9" />
                        </g>
                        <g data-gear="2" class="g-blue">
                          <path d="M17 27.4l-6.6-3.6 1.6 4.4-2 3.6z" />
                          <path d="M18.6 24.6q13.9-3.4 27.8 0l2.6 3.6q-16.5-3.6-33 0z" />
                        </g>
                        <path data-gear="9" class="g-yellow" d="M23.2 21.8l-1.4-10 4.8 3.9 3.4-5.6 3.4 5.6 4.8-3.9-1.4 10z" />
                        <g data-gear="8" class="g-yellow g-thin">
                          <path d="M6 13.500q0 4.500 4.500 4.500q-4.500 0-4.500 4.500q0-4.500-4.500-4.500q4.500 0 4.500-4.500z" />
                          <path d="M58 27q0 3 3 3q-3 0-3 3q0-3-3-3q3 0 3-3z" />
                          <path d="M17 8q0 2.500 2.500 2.500q-2.500 0-2.500 2.500q0-2.500-2.500-2.500q2.500 0 2.500-2.500z" />
                        </g>
                      </svg>
                      <Bun face="smile" class="buddy" />
                    </span>
                  </button>
                  </>
                )}
                <button type="button" class="stop-token" data-token disabled aria-label={fill(g.goTo, { n: i + 1, title: plain(stop.title) })} aria-current={i === 0 ? 'step' : undefined}>
                  <Icon name={stop.icon} width={30} height={30} />
                </button>
                <span class="stop-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6l-5.9 3.1 1.2-6.6-4.8-4.6 6.6-.9z" /></svg>
                </span>
                {i === c.stops.length - 1 && (
                  <span class="finish" data-finish aria-hidden="true">
                    <svg viewBox="0 0 40 56"><path class="pole" d="M6 4v50" /><path class="cloth" d="M6 5c8-4 14 4 28 0v20c-14 4-20-4-28 0z" /></svg>
                  </span>
                )}
              </div>
              <div class="stop-card">
                <div class="stop-top">
                  <span class="stop-num">{i + 1}</span>
                  <span class:list={['k-sticker', 'is-flat', stickerTone[stop.state]]}>{stop.tag}</span>
                </div>
                <h2 class="k-h3">{stop.title.split(/\[|\]/).map((part, j) => (j % 2 ? <span class="k-hl">{part}</span> : part))}</h2>
                <p>{stop.desc}</p>
                {stop.state === 'test' && (
                  <a class="k-btn is-lime test-btn" href={`/${locale}/fans`}>
                    <Icon name="simple-icons:wechat" width={20} height={20} />
                    {c.testBtn}
                  </a>
                )}
                {stop.state === 'ask' && (
                  <a class="k-btn is-lime ask-btn" href={`/${locale}/feedback`}>
                    <Icon name="lucide:message-square-plus" width={20} height={20} />
                    {c.askBtn}
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="hud" data-hud data-text={JSON.stringify(g)}>
        <p class="hud-msg" data-msg aria-live="polite">{g.intro}</p>
        <p class="hud-count">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6l-5.9 3.1 1.2-6.6-4.8-4.6 6.6-.9z" /></svg>
          <span data-count>{fill(g.count, { n: 1, total: c.stops.length })}</span>
        </p>
        <button type="button" class="k-btn is-lime hud-btn" data-reset hidden>
          <Icon name="lucide:rotate-ccw" width={20} height={20} />
          {g.reset}
        </button>
      </div>
      <p class="map-note">{c.note}</p>

    </div>
  </section>
</Layout>

<style>
  /* The map: nine patches, three across, snaking down. Each patch is a round token with a soft
     bubble under it. The path is drawn through the tokens by the script, so it follows them at any width. */
  .board { position: relative; margin-top: 3rem; }
  .road { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .road path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .road-bed { stroke: #fff; stroke-width: 34; }
  .road-dots { stroke: var(--ink); stroke-width: 6; stroke-dasharray: 1 17; opacity: 0.8; }

  .map { list-style: none; position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3.5rem 3.5rem; padding: 0 80px; }
  .stop { position: relative; display: flex; flex-direction: column; padding-top: 118px; translate: 0 var(--dy, 0); }
  /* row 1 runs left to right, row 2 right to left, row 3 left to right */
  .stop-4 { grid-area: 2 / 3; } .stop-5 { grid-area: 2 / 2; } .stop-6 { grid-area: 2 / 1; }
  .is-here { z-index: 3; }

  .stop-node { position: relative; width: 72px; height: 72px; margin-left: calc(var(--x, 50%) - 36px); z-index: 1; }
  .stop-token {
    display: grid; place-items: center; width: 72px; height: 72px; padding: 0; border-radius: 52% 48% 55% 45% / 47% 54% 46% 53%;
    border: 2px solid var(--ink); box-shadow: 0 5px 0 0 var(--ink); background: #fff; color: var(--ink);
    font: inherit; cursor: pointer; rotate: calc(var(--tilt, 0deg) * -3); transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .stop-token :global(svg) { rotate: calc(var(--tilt, 0deg) * 3); }
  .stop-token:hover { transform: translateY(-3px) scale(1.05); }
  .stop-token:active { transform: translateY(4px); box-shadow: 0 1px 0 0 var(--ink); }
  .stop-token:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .stop-token:disabled { cursor: default; transform: none; }
  .is-here .stop-token { background: var(--lime); }
  .is-now .stop-token, .is-test .stop-token { background: var(--blue); color: #fff; }
  .is-next .stop-token { background: var(--yellow); }
  .is-later .stop-token { border-style: dashed; box-shadow: none; }
  .is-later .stop-token:active { box-shadow: none; }

  /* the words for a stop sit in a tilted bubble that points up at its token */
  .stop-card {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 0.55rem; margin-top: 1.4rem; padding: 1.25rem 1.45rem 1.4rem;
    border: 2px solid var(--ink); background: #fff; box-shadow: 3px 5px 0 0 var(--ink); rotate: var(--tilt, 0deg);
    border-radius: 30px 38px 32px 42px / 38px 30px 42px 32px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .stop:nth-child(even) .stop-card { border-radius: 40px 30px 44px 32px / 30px 40px 32px 44px; }
  .stop:nth-child(3n) .stop-card { border-radius: 34px 44px 30px 38px / 44px 32px 40px 30px; }
  .stop-card::before {
    content: ''; position: absolute; top: -10px; left: calc(var(--x, 50%) - 9px); width: 16px; height: 16px; rotate: 45deg;
    border: 2px solid var(--ink); border-right: 0; border-bottom: 0; border-radius: 4px 0 0 0; background: inherit;
  }
  .stop-card p { color: var(--muted); font-size: 1.04rem; line-height: 1.65; }
  .stop-top { display: flex; align-items: center; gap: 0.6rem; }
  .stop-num { display: grid; place-items: center; width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%; border: 2px solid var(--ink); background: #fff; font-weight: 900; font-size: 0.95rem; color: var(--ink); }
  :global(html.js) .stop-card { cursor: pointer; }
  :global(html.js) .is-current .stop-card { background: var(--yellow-soft); transform: translateY(-4px); box-shadow: 3px 9px 0 0 var(--ink); }

  /* a star is stamped on every stop the bun has landed on */
  .stop-star {
    position: absolute; right: -9px; bottom: -9px; display: grid; place-items: center; width: 28px; height: 28px;
    border-radius: 50%; border: 2px solid var(--ink); background: #fff; pointer-events: none;
    scale: 0; rotate: -30deg; transition: scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), rotate 0.3s ease;
  }
  .stop-star path, .hud-count path { fill: var(--yellow); stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  :global(html.js) .is-visited .stop-star { scale: 1; rotate: 12deg; }

  /* the flag where the path ends, and a little sky */
  .finish { position: absolute; left: 150px; top: -34px; width: 40px; pointer-events: none; }
  .finish svg { display: block; width: 100%; overflow: visible; }
  .finish .pole { fill: none; stroke: var(--ink); stroke-width: 4; stroke-linecap: round; }
  .finish .cloth { fill: var(--coral); stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .deco { position: absolute; pointer-events: none; }
  .deco svg { display: block; width: 100%; overflow: visible; }
  .cloud path { fill: #fff; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .spark path { fill: var(--yellow); stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .cloud-1 { width: 96px; left: 39%; top: 6px; rotate: -4deg; }
  .cloud-2 { width: 74px; right: 0; top: 37%; rotate: 5deg; }
  .cloud-3 { width: 84px; left: 0; top: 66%; rotate: -3deg; }
  .spark-1 { width: 26px; left: 5%; top: 30px; }
  .spark-2 { width: 18px; right: 9%; top: 0; }
  .spark-3 { width: 22px; left: 47%; top: 35%; }
  .spark-4 { width: 18px; right: 2%; top: 72%; }

  /* the bun is the game piece: it lives on today's stop and is moved from there by the script.
     Clicking it makes it jump. What it is wearing is switched on by has-N classes, one per stop. */
  .is-here .stop-node { z-index: 3; }
  .stop-bun {
    position: absolute; left: 50%; bottom: 66px; width: 84px; margin-left: -42px; padding: 0; border: 0; border-radius: 40%;
    background: none; font: inherit; color: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  .stop-bun:disabled { cursor: default; }
  .stop-bun:focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .bun-fig { position: relative; display: block; scale: var(--grow, 1); transform-origin: 50% 100%; transition: scale 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .bun-fig :global(.bun) { width: 100%; }
  .bun-fig :global(.bun-win), .bun-fig :global(.bun-poke), .map.is-won .bun-fig :global(.bun-idle) { display: none; }
  .map.is-won .bun-fig :global(.bun-win) { display: block; }
  .map .is-poked .bun-fig :global(.bun-idle), .map .is-poked .bun-fig :global(.bun-win) { display: none; }
  .map .is-poked .bun-fig :global(.bun-poke) { display: block; }
  .bun-fig :global(.buddy) { display: none; position: absolute; left: 88%; bottom: 0; width: 42%; }
  .has-6 .bun-fig :global(.buddy) { display: block; }
  .gear { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .gear * { stroke: var(--ink); stroke-width: 1.3; stroke-linejoin: round; }
  .gear [data-gear] { display: none; transform-box: fill-box; transform-origin: center; }
  .has-2 [data-gear='2'], .has-3 [data-gear='3'], .has-4 [data-gear='4'], .has-5 [data-gear='5'],
  .has-7 [data-gear='7'], .has-8 [data-gear='8'], .has-9 [data-gear='9'] { display: inline; }
  .g-ink * , .g-ink { fill: var(--ink); }
  .g-coral, .g-coral * { fill: var(--coral); }
  .g-blue, .g-blue * { fill: var(--blue); }
  .g-yellow, .g-yellow * { fill: var(--yellow); }
  .g-purple { fill: var(--purple); }
  .g-thin * { stroke-width: 1; }
  .here-flag { position: absolute; left: 50%; bottom: calc(152px + var(--lift, 0px)); transform: translateX(-50%) rotate(-4deg); transition: translate 0.3s ease; pointer-events: none; }
  .map.is-away .here-flag { translate: 0 calc(76px + var(--lift, 0px)); }
  @media (prefers-reduced-motion: no-preference) {
    .bun-fig { animation: bun-hop 1.6s ease-in-out infinite; }
    .gear [data-gear], .bun-fig :global(.buddy) { animation: gear-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .gear [data-gear='8'] path { transform-box: fill-box; transform-origin: center; animation: twinkle 1.4s ease-in-out infinite; }
    .gear [data-gear='8'] path:nth-child(2) { animation-delay: 0.45s; }
    .gear [data-gear='8'] path:nth-child(3) { animation-delay: 0.9s; }
  }
  @keyframes bun-hop { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }
  @keyframes gear-pop { 0% { scale: 0; } 100% { scale: 1; } }
  @keyframes twinkle { 0%, 100% { scale: 1; } 50% { scale: 0.55; } }

  .stop-bun :global(.bit) {
    position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px;
    border: 2px solid var(--ink); border-radius: 3px; background: var(--c);
    animation: bit-fly var(--t) cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  .stop-bun :global(.bit.is-round) { border-radius: 50%; }
  @keyframes bit-fly {
    0% { transform: translate(0, 0) rotate(0) scale(0.4); opacity: 1; }
    55% { transform: translate(var(--dx), var(--dy)) rotate(var(--r)) scale(1); opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + 70px)) rotate(calc(var(--r) * 2)) scale(0.9); opacity: 0; }
  }

  /* the controls stay at the bottom of the window while the map is on screen */
  .hud { display: none; }
  :global(html.js) .hud {
    position: sticky; bottom: 1rem; z-index: 5; margin: 6rem auto 0; width: fit-content; max-width: 100%;
    display: flex; align-items: center; gap: 0.7rem 1.1rem; padding: 0.65rem 0.8rem 0.65rem 1.6rem; min-height: 62px;
    border-radius: 999px; border: 2px solid var(--ink); background: #fff; box-shadow: 0 5px 0 0 var(--ink);
  }
  .hud-msg:empty { display: none; }
  .hud-msg { flex: 1 1 auto; min-width: 0; color: var(--ink); font-size: 1.02rem; font-weight: 800; line-height: 1.45; }
  .hud-count { display: flex; align-items: center; gap: 0.35rem; flex: 0 0 auto; padding: 0.3rem 0.85rem; border-radius: 999px; border: 2px solid var(--ink); background: var(--yellow-soft); color: var(--ink); font-size: 0.95rem; font-weight: 900; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hud-btn { flex: 0 0 auto; padding: 0.5rem 1.1rem; border-radius: 999px; }
  .hud-btn[hidden] { display: none; }

  .map-note { margin-top: 2.5rem; text-align: center; color: var(--muted); font-size: 1rem; font-weight: 700; }

  /* the last stop: the road is still being built, so the flag always sits on the visitor's suggestion */
  .stop-10 { grid-column: 1 / -1; }
  .stop-10 .stop-card { align-self: center; width: min(100%, 620px); background: var(--yellow-soft); }
  .stop-10 .stop-card::before { left: calc(50% - 9px); }
  .stop-10 .k-h3 { font-size: 1.5rem; }
  .is-ask .stop-token { background: var(--purple); color: #fff; border-style: dashed; }
  .ask-btn, .test-btn { margin-top: 0.4rem; }
  .test-btn { padding: 0.6rem 1.1rem; font-size: 0.98rem; white-space: normal; }

  /* Narrow screens: one stop per row, tokens swapping sides so the path still winds its way down. */
  @media (max-width: 1000px) {
    .board { max-width: 640px; margin: 3.5rem auto 0; }
    .map { display: flex; flex-direction: column; gap: 2.5rem; padding: 0; }
    .stop { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: 1rem; padding-top: 0; translate: none; }
    .stop:nth-child(even) { grid-template-columns: minmax(0, 1fr) 64px; }
    .stop:nth-child(even) .stop-node { order: 2; }
    .stop-node { width: 64px; height: 64px; margin-left: 0; }
    .stop-token { width: 64px; height: 64px; }
    .stop-card { margin-top: 0; padding: 1.1rem 1.2rem 1.2rem; }
    .stop-card::before { display: none; }
    .stop-10 .stop-card { width: auto; align-self: stretch; }
    .stop-10 .k-h3 { font-size: 1.25rem; }
    .road-bed { stroke-width: 26; }
    .stop-bun { bottom: 54px; width: 54px; margin-left: -27px; }
    .bun-fig :global(.buddy) { left: 66%; width: 36%; bottom: -3%; }
    .here-flag, .cloud { display: none; }
    .finish { left: 14px; top: 84px; width: 32px; }
    :global(html.js) .hud { flex-wrap: wrap; justify-content: space-between; width: auto; min-height: 0; border-radius: 24px; padding: 0.7rem 0.9rem 0.85rem 1rem; }
    .hud-msg { flex-basis: 100%; font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stop-token, .stop-token:hover, .stop-card, .stop-star, .here-flag, .bun-fig { transition: none; }
    .stop-token:hover, :global(html.js) .is-current .stop-card { transform: none; }
  }
</style>

<script>
  const board = document.querySelector<HTMLElement>('[data-board]');
  const map = board?.querySelector<HTMLElement>('[data-map]');
  const hud = document.querySelector<HTMLElement>('[data-hud]');
  const bun = map?.querySelector<HTMLButtonElement>('[data-bun]');

  if (board && map && hud && bun) {
    type Point = { x: number; y: number; stop?: number };
    const text: Record<string, any> = JSON.parse(hud.dataset.text ?? '{}');
    const fig = bun.querySelector<HTMLElement>('.bun-fig')!;
    const stops = [...map.querySelectorAll<HTMLElement>('[data-stop]')];
    const nodes = stops.map((stop) => stop.querySelector<HTMLElement>('.stop-node')!);
    const tokens = stops.map((stop) => stop.querySelector<HTMLButtonElement>('[data-token]')!);
    const roads = [...board.querySelectorAll<SVGPathElement>('[data-road]')];
    const measure = board.querySelector<SVGPathElement>('[data-measure]')!;
    const finish = board.querySelector<HTMLElement>('[data-finish]');
    const msg = hud.querySelector<HTMLElement>('[data-msg]')!;
    const count = hud.querySelector<HTMLElement>('[data-count]')!;
    const resetBtn = hud.querySelector<HTMLButtonElement>('[data-reset]')!;
    const last = stops.length - 1;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 1000px)');
    const visited = new Set([0]);
    let pos = 0;
    let target = 0;
    let walking = false;
    let spots: Point[] = [];
    let legs: string[] = [];

    const fill = (key: string, values: Record<string, string | number>) =>
      (text[key] ?? '').replace(/\{(\w+)\}/g, (_: string, name: string) => String(values[name] ?? ''));

    // Draw the path as one smooth curve through the middle of every token, swinging out to the
    // side where the map drops to the next row, and keep the piece between each pair of stops for the bun.
    const draw = () => {
      const frame = board.getBoundingClientRect();
      const mid = (el: Element): Point => {
        const r = el.getBoundingClientRect();
        return { x: r.left + r.width / 2 - frame.left, y: r.top + r.height / 2 - frame.top };
      };
      spots = nodes.map((node, i) => ({ ...mid(node), stop: i }));
      const pts: Point[] = [];
      spots.forEach((p, i) => {
        pts.push(p);
        const next = spots[i + 1];
        if (!next || narrow.matches || Math.abs(next.y - p.y) < 160) return;
        const right = p.x > frame.width / 2;
        const out = right ? Math.min(frame.width - 14, Math.max(p.x, next.x) + 130) : Math.max(14, Math.min(p.x, next.x) - 130);
        pts.push({ x: out, y: (p.y + next.y) / 2 });
      });
      if (finish) {
        const r = finish.getBoundingClientRect();
        pts.push({ x: r.left + r.width * 0.15 - frame.left, y: r.bottom - frame.top });
      }
      const at = (i: number) => pts[Math.max(0, Math.min(pts.length - 1, i))];
      const n = (v: number) => v.toFixed(1);
      let whole = `M${n(pts[0].x)} ${n(pts[0].y)}`;
      let leg = '';
      legs = [];
      for (let i = 0; i < pts.length - 1; i += 1) {
        const [a, b, c, d] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
        const curve = `C${n(b.x + (c.x - a.x) / 6)} ${n(b.y + (c.y - a.y) / 6)} ${n(c.x - (d.x - b.x) / 6)} ${n(c.y - (d.y - b.y) / 6)} ${n(c.x)} ${n(c.y)}`;
        whole += curve;
        if (b.stop !== undefined) leg = `M${n(b.x)} ${n(b.y)}`;
        leg += curve;
        if (c.stop !== undefined) legs.push(leg);
      }
      roads.forEach((road) => road.setAttribute('d', whole));
    };

    // the bun lives on the first stop and is moved from there
    const put = (x: number, y: number) => { bun.style.translate = `${(x - spots[0].x).toFixed(1)}px ${(y - spots[0].y).toFixed(1)}px`; };
    const place = (i: number) => put(spots[i].x, spots[i].y);

    // hop along the curve between two neighbouring stops
    const hop = (to: number, pace: number) => new Promise<void>((done) => {
      const forward = to > pos;
      measure.setAttribute('d', legs[Math.min(pos, to)] ?? '');
      const length = measure.getTotalLength();
      if (calm.matches || !length) { pos = to; place(to); done(); return; }
      const duration = Math.min(1300, Math.max(420, length * 2.1)) * pace;
      const jumps = Math.max(1, Math.round((length * Math.min(1, pace * 1.4)) / 120));
      let start = 0;
      const step = (now: number) => {
        start ||= now;
        const t = Math.min(1, (now - start) / duration);
        const p = measure.getPointAtLength(length * (forward ? t : 1 - t));
        put(p.x, p.y - Math.abs(Math.sin(Math.PI * t * jumps)) * 26);
        if (t < 1) { requestAnimationFrame(step); return; }
        pos = to;
        place(to);
        done();
      };
      requestAnimationFrame(step);
    });

    const showInView = (i: number) => {
      const box = stops[i].querySelector('.stop-card')!.getBoundingClientRect();
      const nodeBox = nodes[i].getBoundingClientRect();
      // leave room above the token for the bun, which grows, and for the sign above it on the first stop
      const top = Math.min(box.top, nodeBox.top - (narrow.matches ? 90 : i === 0 ? 230 : 130));
      const bottom = Math.max(box.bottom, nodeBox.bottom);
      const roomTop = 96;
      const roomBottom = window.innerHeight - hud.offsetHeight - 40;
      if (top >= roomTop && bottom <= roomBottom) return;
      const delta = top < roomTop ? top - roomTop : Math.min(bottom - roomBottom, top - roomTop);
      window.scrollBy({ top: delta, behavior: calm.matches ? 'auto' : 'smooth' });
    };

    // one more thing to wear for every stop collected, and the bun grows with it
    const dress = () => {
      const gear = visited.size - 1;
      const scale = 1 + gear * 0.04;
      const base = bun.offsetWidth * (38 / 43);
      stops.forEach((_, i) => bun.classList.toggle(`has-${i + 1}`, i > 0 && visited.has(i)));
      bun.style.setProperty('--grow', scale.toFixed(2));
      map.style.setProperty('--lift', `${Math.round(base * (scale - 1) + (visited.has(last) ? 12 * scale : 0))}px`);
    };

    const burst = (n: number) => {
      const colours = ['var(--lime)', 'var(--yellow)', 'var(--blue)', 'var(--purple)', 'var(--coral)', '#fff'];
      const centre = bun.getBoundingClientRect();
      const cx = centre.left + centre.width / 2;
      const roomLeft = cx - 16;
      const roomRight = document.documentElement.clientWidth - cx - 16;
      for (let i = 0; i < n; i += 1) {
        const bit = document.createElement('span');
        const angle = Math.random() * Math.PI * 2;
        const far = (n > 12 ? 60 : 40) + Math.random() * (n > 12 ? 130 : 50);
        const dx = Math.max(-roomLeft, Math.min(roomRight, Math.cos(angle) * far));
        const dy = Math.sin(angle) * far * 0.8 - 50;
        bit.className = i % 3 ? 'bit' : 'bit is-round';
        bit.style.setProperty('--c', colours[i % colours.length]);
        bit.style.setProperty('--dx', `${dx.toFixed(0)}px`);
        bit.style.setProperty('--dy', `${dy.toFixed(0)}px`);
        bit.style.setProperty('--r', `${(Math.random() * 360 - 180).toFixed(0)}deg`);
        bit.style.setProperty('--t', `${(1 + Math.random() * 0.6).toFixed(2)}s`);
        bit.addEventListener('animationend', () => bit.remove());
        bun.append(bit);
      }
    };

    const arrive = () => {
      const isNew = !visited.has(pos);
      const item = text.items?.[pos - 1] ?? '';
      visited.add(pos);
      dress();
      stops.forEach((stop, i) => {
        stop.classList.toggle('is-current', i === pos);
        stop.classList.toggle('is-visited', visited.has(i));
        const label = fill('goTo', { n: i + 1, title: stop.dataset.title ?? '' });
        tokens[i].setAttribute('aria-label', visited.has(i) ? label + text.visited : label);
        if (i === pos) tokens[i].setAttribute('aria-current', 'step');
        else tokens[i].removeAttribute('aria-current');
      });
      count.textContent = fill('count', { n: visited.size, total: stops.length });
      const atEnd = pos === last;
      const left = stops.length - visited.size;
      const got = isNew && item;
      map.classList.toggle('is-won', atEnd);
      map.classList.toggle('is-away', pos !== 0);
      if (atEnd) msg.textContent = (got ? fill('got', { item }) : '') + (left === 0 ? fill('endAll', { total: stops.length }) : fill(left === 1 ? 'endOne' : 'endMany', { n: left }));
      else msg.textContent = fill(got ? 'atGot' : 'at', { n: pos + 1, title: stops[pos].dataset.title ?? '', item });
      // the way back is only offered at the end; if it had the keyboard, hand that to the stop the bun is on
      const hadFocus = document.activeElement === resetBtn;
      resetBtn.hidden = !atEnd;
      if (hadFocus && !atEnd) tokens[pos].focus({ preventScroll: true });
      if (!calm.matches) { if (atEnd) burst(28); else if (got) burst(8); }
    };

    const walkTo = async (to: number, quick = false) => {
      target = Math.max(0, Math.min(last, to));
      if (walking) return;
      if (target === pos) { showInView(pos); return; }
      walking = true;
      map.classList.remove('is-won');
      map.classList.add('is-away');
      showInView(target);
      // a long trip is taken faster, so the far end of the map is never more than a few seconds away
      while (pos !== target) await hop(pos + Math.sign(target - pos), quick ? 0.3 : Math.max(0.45, 1 - 0.14 * (Math.abs(target - pos) - 1)));
      walking = false;
      arrive();
    };

    stops.forEach((stop, i) => {
      tokens[i].addEventListener('click', () => walkTo(i));
      // the whole bubble is a bigger target for a mouse or a finger; the token is the real button
      stop.querySelector('.stop-card')!.addEventListener('click', () => {
        if (!window.getSelection()?.toString()) walkTo(i);
      });
    });

    resetBtn.addEventListener('click', () => walkTo(0, true));

    // poke the bun: it winks, jumps and wobbles
    let poke = 0;
    bun.addEventListener('click', () => {
      bun.classList.add('is-poked');
      window.clearTimeout(poke);
      poke = window.setTimeout(() => bun.classList.remove('is-poked'), 900);
      if (calm.matches || !fig.animate) return;
      fig.animate(
        [
          { translate: '0 0', rotate: '0deg' },
          { translate: '0 -34px', rotate: '-12deg', offset: 0.35 },
          { translate: '0 0', rotate: '10deg', offset: 0.7 },
          { translate: '0 0', rotate: '0deg' },
        ],
        { duration: 620, easing: 'ease-in-out' },
      );
      burst(6);
    });

    // the map changes shape with the window, so redraw the path and put the bun back on its stop
    const settle = () => { draw(); if (!walking) place(pos); };
    settle();
    if ('ResizeObserver' in window) new ResizeObserver(settle).observe(board);
    bun.disabled = false;
    tokens.forEach((token) => { token.disabled = false; });
  }
</script>
