---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Bun from './Bun.astro';
import { aboutUi, aboutStory, defaultLocale } from '../i18n/about';
import type { AboutLang, AboutKey } from '../i18n/about';

const locale = (Astro.currentLocale ?? defaultLocale) as AboutLang;
const t = (key: AboutKey): string =>
  (aboutUi[locale] as typeof aboutUi[typeof defaultLocale])[key] ?? aboutUi[defaultLocale][key];

// The key people. To use a real photo, drop a square image into
// /public/shared-pic/team/ and set `photo` to its path — the card uses it
// automatically and falls back to the bun `avatar` until then.
const team = [
  // NOTE: the two women's photos are a tentative guess — swap the ceo/tech
  // `photo` values if Katherine and Nicole are reversed.
  { lead: true, key: 'ceo',    name: 'Katherine Jin', avatar: 'avatar9', photo: '/people/1776865979464.png',  accent: '#9ad513', roleColor: '#4d7d09', mascot: '/shared-pic/bun-delighted.svg', linkedin: 'https://www.linkedin.com/in/katherine-j-779746193/' },
  { lead: true, key: 'tech',   name: 'Nicole Nan',    avatar: 'avatar2', photo: '/people/1768978273644.jpeg', accent: '#3486F3', roleColor: '#1f66c9', roleWhite: true, mascot: '/shared-pic/bun-wink.svg', linkedin: 'https://www.linkedin.com/in/nicole-nan-501a6831b/' },
  // Freya is listed by her Chinese name only; her title, background line and bio are her own words (2026-10-17).
  { key: 'pm',     name: 'Mengyan Xu',    avatar: 'avatar3', photo: '/people/mengyan.jpg',        accent: '#f56767', roleColor: '#b93a3a', roleWhite: true, mascot: '/shared-pic/buns/bun-happy.svg', linkedin: undefined },
  { key: 'design', name: 'Guanghan Li',   avatar: 'avatar1', photo: '/people/1771639472356.jpeg', accent: '#8b6ef6', roleColor: '#6d4bc4', roleWhite: true, mascot: '/shared-pic/bun-white.svg', linkedin: 'https://www.linkedin.com/in/guanghan-li-ab9973258/' },
  // Luna has not sent a LinkedIn yet, so her card is not a link.
  { key: 'marketing', name: 'Luna Zheng', avatar: 'avatar5', photo: '/people/luna.jpg', accent: '#F6B73C', roleColor: '#9a6500', mascot: '/shared-pic/buns/bun-smile.svg', linkedin: undefined },
];

const story = aboutStory[locale] ?? aboutStory[defaultLocale];
const description = story.description;
const hl = (text: string) => text.split(/\[|\]/);
---

<Layout title={`${t('page-title')} | BlotzTask`} description={description}>
  <!-- WHO WE ARE -->
  <section class="band band-top band-blue">
    <div class="wrap scene">
      <div class="scene-text">
        <h1 class="k-h1">{hl(story.heroTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h1>
        <p class="k-lead">{story.heroLead}</p>
      </div>
      <div class="scene-art">
        <!-- the bun at its desk, behind a laptop -->
        <div class="desk">
          <!-- read as a pair, like a tongue twister: 白天上班上课 / 晚上包子娱乐 -->
          <span class="k-sticker desk-note desk-note-day"><Icon name="lucide:sun" width={22} height={22} />{story.noteDay}</span>
          <span class="k-sticker desk-note desk-note-night"><Icon name="lucide:moon" width={20} height={20} />{story.noteNight}</span>
          <Bun face="happy" class="desk-bun" />
          <span class="desk-laptop" aria-hidden="true"><span class="desk-logo"></span></span>
          <span class="desk-mug" aria-hidden="true"></span>
          <span class="desk-top" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="band">
    <div class="wrap story">
      <div class="story-text reveal">
        <h2 class="k-h2">{hl(story.storyTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h2>
        {story.story.map((para) => <p>{para}</p>)}
      </div>
      <div class="k-card story-quote reveal">
        <Bun face="smile" tone="lilac" class="story-bun" />
        <span class="k-sticker is-flat story-label" style="margin-bottom: 1rem;">{story.goalLabel}</span>
        <p class="story-goal" style="margin: 0; color: var(--ink); font-size: clamp(1.4rem, 2.1vw, 1.95rem); font-weight: 900; line-height: 1.45;">{story.goal}</p>
        <p class="story-after">{story.goalAfter}</p>
      </div>
    </div>
  </section>

  <!-- MEMBERS -->
  <section class="band band-lime">
    <h2 class="wrap k-h2 k-center team-title reveal">{hl(story.teamTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h2>
    <ul class="wrap team-grid">
      {team.map(({ key, name, avatar, photo, accent, roleColor, roleWhite, linkedin, lead }) => {
        const tag = t(`${key}-tag` as AboutKey);
        return (
          <li class:list={['reveal', { 'is-lead': lead }]}>
            {/* only the name, the title and one line of background show; the bio and LinkedIn fold away */}
            <div class="k-card team-card" style={`--accent: ${accent};`}>
              <span class="team-photo-ring">
                {photo ? (
                  <img
                    class="team-photo" src={photo} alt={name} width="120" height="120" loading="lazy"
                    data-fallback={`/shared-pic/moods/${avatar}.svg`}
                    onerror="this.onerror=null;this.src=this.dataset.fallback;"
                  />
                ) : (
                  <img class="team-photo is-avatar" src={`/shared-pic/moods/${avatar}.svg`} alt="" width="120" height="120" loading="lazy" />
                )}
              </span>
              <h3 class="k-h3">{name}</h3>
              {/* dark text is hard to read on the blue, purple and coral, so those use the darker shade with white text */}
              <span class="k-sticker is-flat team-role" style={roleWhite ? `background: ${roleColor}; color: #fff;` : `background: ${accent};`}>{t(`${key}-role` as AboutKey)}</span>
              {/* kept even when empty, so every closed card is the same height */}
              <p class="team-tag">{tag}</p>
              <details class="team-more">
                <summary>
                  <span class="team-more-open">{t('more')}</span><span class="team-more-close">{t('less')}</span>
                  <Icon name="lucide:chevron-down" width={18} height={18} />
                </summary>
                <p class="team-bio">{t(`${key}-bio` as AboutKey)}</p>
                {linkedin && (
                  <a class="team-link" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${name} on ${t('connect')}`}>
                    <Icon name="lucide:linkedin" width={18} height={18} />{t('connect')}
                  </a>
                )}
              </details>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="band band-yellow" id="find-us">
    <div class="wrap k-cta">
      <h2 class="k-h2">{t('contact-title')}</h2>
      <p class="k-lead">{t('contact-sub')}</p>
      <div class="k-btn-row">
        <a class="k-btn is-coral" href="https://www.xiaohongshu.com/user/profile/67bc12d6000000000e01f09a" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:xiaohongshu" width={22} height={22} />
          {t('contact-rn-name')}
        </a>
        <a class="k-btn" href="https://www.instagram.com/blotztask.app/" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:instagram" width={20} height={20} />
          {t('contact-ig-name')}
        </a>
        <a class="k-btn is-blue" href="https://www.linkedin.com/company/blotz-app/" target="_blank" rel="noopener noreferrer">
          <Icon name="lucide:linkedin" width={20} height={20} />
          {t('contact-li-name')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* the bun at its desk */
  .desk { position: relative; width: 100%; max-width: 30rem; height: 21rem; }
  .desk-top {
    position: absolute; left: 0; right: 0; bottom: 1.2rem; height: 1.5rem;
    border-radius: 999px; border: 2px solid var(--ink); background: var(--yellow); box-shadow: 0 5px 0 0 var(--ink);
  }
  .desk :global(.desk-bun) { position: absolute; left: 50%; bottom: 7.4rem; width: 13.5rem; margin-left: -6.75rem; }
  .desk-laptop {
    position: absolute; left: 50%; bottom: 2.7rem; width: 15rem; height: 9.4rem; margin-left: -7.5rem;
    display: grid; place-items: center;
    border-radius: 16px 16px 6px 6px; border: 2px solid var(--ink); background: #fff;
  }
  .desk-logo { width: 2.1rem; height: 2.1rem; border-radius: 50%; border: 2px solid var(--ink); background: var(--lime); }
  .desk-mug {
    position: absolute; right: 7%; bottom: 2.7rem; width: 2.6rem; height: 3rem;
    border-radius: 6px 6px 12px 12px; border: 2px solid var(--ink); background: var(--coral);
  }
  .desk-mug::after {
    content: ''; position: absolute; left: 100%; top: 0.55rem; width: 0.85rem; height: 1.3rem;
    border: 2px solid var(--ink); border-left: 0; border-radius: 0 10px 10px 0;
  }
  .desk-note { position: absolute; z-index: 2; gap: 0.5rem; padding: 0.5rem 1.15rem; font-size: clamp(1.25rem, 1.9vw, 1.6rem); letter-spacing: 0.04em; box-shadow: 0 4px 0 0 var(--ink); }
  .desk-note-day { left: -4%; top: 1.6rem; background: #fff6cf; transform: rotate(-7deg); }
  .desk-note-day :global(svg) { color: #f0a20c; }
  .desk-note-night { right: -4%; top: -0.6rem; background: var(--ink); color: #fff; box-shadow: 0 4px 0 0 var(--purple); transform: rotate(6deg); }
  .desk-note-night :global(svg) { color: var(--yellow); }
  @media (prefers-reduced-motion: no-preference) {
    .desk :global(.desk-bun) { animation: desk-bob 4s ease-in-out infinite; }
  }
  @keyframes desk-bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }

  /* the story: words on the left, the team's goal on the right */
  .story { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 4.5rem; align-items: center; }
  .story-text { display: flex; flex-direction: column; gap: 1.3rem; }
  .story-text .k-h2 { margin-bottom: 0.5rem; }
  .story-text p { color: var(--ink); font-size: clamp(1.1rem, 1.35vw, 1.28rem); line-height: 1.85; }
  .story-quote { position: relative; margin: 0; padding: 2.6rem 2rem 2rem; background: var(--yellow-soft); transform: rotate(1.2deg); }
  .story-quote :global(.story-bun) { position: absolute; right: 1.6rem; top: -2.9rem; width: 5.2rem; transform: rotate(8deg); }
  .story-label { margin-bottom: 1rem; }
  .story-goal { margin: 0; color: var(--ink); font-size: clamp(1.4rem, 2.1vw, 1.95rem); font-weight: 900; line-height: 1.45; }
  .story-quote figcaption { margin-top: 0.9rem; color: var(--muted); font-size: 1rem; line-height: 1.6; }
  .story-after { margin-top: 1.3rem; padding-top: 1.3rem; border-top: 2px dashed var(--ink); color: var(--ink); font-size: 1.1rem; font-weight: 800; line-height: 1.7; }

  .team-title { margin-bottom: 3rem; }
  /* Katherine and Nicole lead on a row of their own; the other three share the row under them.
     Opening one card does not stretch the others. */
  .team-grid { list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: start; gap: 1.25rem; }
  .team-grid > li { display: flex; grid-column: span 2; }
  .team-grid > li.is-lead { grid-column: span 3; }
  /* a card lies on its side: the photo on a strip of the person's colour, the words beside it */
  .team-card {
    position: relative; overflow: hidden; width: 100%; padding: 1.4rem 1.8rem 1.4rem 1.1rem;
    display: grid; grid-template-columns: 128px minmax(0, 1fr); column-gap: 1.8rem; row-gap: 0.5rem;
    align-content: center; justify-items: start; text-align: left;
  }
  .team-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 78px; background: var(--accent); border-right: 2px solid var(--ink); }
  .team-card > * { position: relative; grid-column: 2; }
  .team-card > .team-photo-ring { grid-column: 1; grid-row: 1 / span 4; align-self: start; }
  .team-photo-ring { display: block; width: 128px; height: 128px; padding: 5px; border-radius: 50%; border: 2px solid var(--ink); background: #fff; }
  .team-photo { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid var(--ink); background: #fff; }
  .team-photo.is-avatar { object-fit: contain; }
  .team-role { color: var(--ink); white-space: normal; text-align: center; }
  .team-tag { color: var(--ink); font-size: 1rem; font-weight: 800; line-height: 1.5; }
  .team-tag:empty { display: none; }
  .team-more { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; width: 100%; }
  .team-more summary {
    display: inline-flex; align-items: center; gap: 0.25rem; margin-left: -0.9rem; padding: 0.3rem 0.9rem; border-radius: 999px;
    color: var(--ink); font-size: 0.95rem; font-weight: 900; cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
  .team-more summary::-webkit-details-marker { display: none; }
  .team-more summary:hover { background: var(--lime-soft); }
  .team-more summary:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .team-more summary :global(svg) { transition: rotate 0.2s ease; }
  .team-more[open] summary :global(svg) { rotate: 180deg; }
  .team-more-close, .team-more[open] .team-more-open { display: none; }
  .team-more[open] .team-more-close { display: inline; }
  .team-bio { color: var(--muted); font-size: 1.02rem; line-height: 1.7; }
  .team-link {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 1.15rem;
    border-radius: 999px; border: 2px solid var(--ink); box-shadow: 0 3px 0 0 var(--ink);
    background: #0a66c2; color: #fff; font-size: 0.98rem; font-weight: 900; line-height: 1.3; text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .team-link:hover { transform: translateY(-2px); box-shadow: 0 5px 0 0 var(--ink); }
  .team-link:active { transform: translateY(2px); box-shadow: 0 1px 0 0 var(--ink); }
  .team-link:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  /* the three under the leads stand up: their colour across the top, the photo on its edge */
  @media (min-width: 901px) {
    .team-grid > li:not(.is-lead) .team-card { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; padding: 1.6rem 1rem 1.2rem; text-align: center; }
    .team-grid > li:not(.is-lead) .team-photo-ring { align-self: center; }
    .team-grid > li:not(.is-lead) .team-card::before { inset: 0 0 auto; width: auto; height: 92px; border-right: 0; border-bottom: 2px solid var(--ink); }
    /* the background line keeps two lines of room, even when empty, so the three are the same height */
    .team-grid > li:not(.is-lead) .team-tag { display: block; min-height: 3em; }
    .team-grid > li:not(.is-lead) .team-more { align-items: center; }
    .team-grid > li:not(.is-lead) .team-more summary { margin-left: 0; }
  }
  @media (max-width: 900px) {
    .story { grid-template-columns: 1fr; gap: 4.5rem; }
    .desk { max-width: 24rem; height: 20rem; }
    .desk :global(.desk-bun) { width: 11.5rem; margin-left: -5.75rem; bottom: 7.5rem; }
    .desk-note-day { top: 3rem; }
    .desk-note-night { top: 0; }
    .desk-laptop { width: 13rem; height: 8.2rem; margin-left: -6.5rem; }
    .team-title { margin-bottom: 2.2rem; }
    /* tablets and phones: one person per row */
    .team-grid { grid-template-columns: minmax(0, 1fr); max-width: 40rem; gap: 0.9rem; }
    .team-grid > li, .team-grid > li.is-lead { grid-column: auto; }
  }
  @media (max-width: 600px) {
    /* phones: a smaller photo and strip */
    .team-card { grid-template-columns: 80px minmax(0, 1fr); column-gap: 1.1rem; row-gap: 0.45rem; padding: 1rem 1.1rem 1rem 0.7rem; }
    .team-card::before { width: 46px; }
    .team-card > .team-photo-ring { width: 80px; height: 80px; padding: 3px; }
    .team-card .k-h3 { font-size: 1.15rem; }
    .team-tag { font-size: 0.92rem; }
    .story-quote { padding: 2.4rem 1.4rem 1.6rem; }
  }
</style>
