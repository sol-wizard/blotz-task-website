---
import Layout from '../layouts/Layout.astro';
import { defaultLocale } from '../i18n/landing';
import { privacy } from '../i18n/privacy';

const locale = Astro.currentLocale ?? defaultLocale;
const content = privacy[locale] ?? privacy[defaultLocale];
---

<Layout title={`${content.title} | BlotzTask`} description={content.description}>
  <div class="policy-page">
    <article class="policy">
      <header class="policy-header">
        <h1>{content.title}</h1>
        <p class="policy-meta" set:html={content.meta} />

        <div class="policy-intro">
          {content.intro.map((text) => <p>{text}</p>)}
        </div>
      </header>

      <div class="policy-body">
        <nav class="policy-toc">
          <p class="toc-label">{content.tocLabel}</p>
          <ol>
            {content.sections.map((section) => (
              <li><a href={`#${section.id}`}>{section.title.replace(/^\d+\.\s*/, '')}</a></li>
            ))}
          </ol>
        </nav>

        <div class="policy-sections">
      {content.sections.map((section) => (
        <section id={section.id}>
          <h2>{section.title}</h2>
          {section.blocks.map((block) => {
            if (block.type === 'h3') return <h3>{block.text}</h3>;
            if (block.type === 'h4') return <h4>{block.text}</h4>;
            if (block.type === 'p') return <p set:html={block.text} />;
            if (block.type === 'ul')
              return (
                <ul>
                  {block.items.map((item) => <li set:html={item} />)}
                </ul>
              );
            if (block.type === 'link')
              return (
                <p>
                  <a href={block.href} target="_blank" rel="noopener noreferrer">{block.text}</a>
                </p>
              );
            return (
              <p class="policy-email">
                <strong>{block.label}</strong> <a href={`mailto:${block.address}`}>{block.address}</a>
              </p>
            );
          })}
        </section>
      ))}
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .policy-page { background: #f8fafc; padding: 5.5rem 1.5rem 5rem; min-height: 100vh; }
  .policy {
    max-width: 1196px; margin: 0 auto;
    background: white; border-radius: 24px; padding: 3rem 3.5rem;
    box-shadow: 0 2px 24px rgba(0,0,0,0.07);
  }
  .policy-body {
    display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 3.5rem;
    align-items: start; margin-top: 2.5rem;
  }
  .policy-sections > section:first-child { margin-top: 0; padding-top: 0; border-top: none; }
  .policy h1 { font-size: 2.4rem; font-weight: 900; color: var(--text); margin-bottom: 0.7rem; letter-spacing: -0.01em; }
  .policy-meta { font-size: 0.9rem; color: var(--muted); padding-bottom: 1.75rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 1.75rem; }
  .policy-header { padding-bottom: 2.5rem; border-bottom: 1px solid #e5e7eb; }
  .policy-intro { max-width: 46rem; }
  .policy-intro p { font-size: 1.06rem; color: #374151; line-height: 1.95; margin-bottom: 0.85rem; }
  .policy-intro p:last-child { margin-bottom: 0; }
  .policy-toc {
    background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 16px;
    padding: 1.4rem 1.5rem; margin-bottom: 0;
    position: sticky; top: 6.5rem;
    max-height: calc(100vh - 9rem); overflow-y: auto;
  }
  .toc-label { font-size: 0.95rem; font-weight: 800; color: var(--text); margin-bottom: 0.75rem; }
  .policy-toc ol { padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .policy-toc a { color: #3486F3; font-size: 0.95rem; font-weight: 600; text-decoration: none; }
  .policy-toc a:hover { text-decoration: underline; }
  .policy section { margin-top: 3rem; padding-top: 3rem; border-top: 1px solid #e5e7eb; }
  .policy h2 { font-size: 1.55rem; font-weight: 900; color: var(--text); margin-bottom: 1.1rem; letter-spacing: -0.01em; }
  .policy h3 { font-size: 1.22rem; font-weight: 800; color: var(--text); margin-top: 2.25rem; margin-bottom: 0.65rem; }
  .policy h4 { font-size: 1.06rem; font-weight: 700; color: var(--text); margin-top: 1.75rem; margin-bottom: 0.5rem; }
  .policy p { font-size: 1rem; color: #374151; line-height: 1.95; margin-bottom: 0.9rem; }
  .policy ul { padding-left: 1.4rem; margin-bottom: 0.9rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .policy li { font-size: 1rem; color: #374151; line-height: 1.9; }
  .policy a { color: #3486F3; font-weight: 600; text-decoration: none; }
  .policy a:hover { text-decoration: underline; }
  .policy-email { margin-top: 1rem; padding: 0.9rem 1.2rem; background: #f0fae0; border-radius: 12px; }
  @media (max-width: 1000px) {
    .policy { max-width: 760px; }
    .policy-body { grid-template-columns: 1fr; gap: 0; margin-top: 2rem; }
    .policy-toc { position: static; max-height: none; overflow-y: visible; }
    .policy-sections > section:first-child { margin-top: 2.25rem; padding-top: 2.25rem; border-top: 1px solid #e5e7eb; }
  }
  @media (max-width: 600px) {
    .policy { padding: 2rem 1.25rem; }
    .policy-page { padding: 5rem 1rem 3rem; }
    .policy h1 { font-size: 1.8rem; }
    .policy h2 { font-size: 1.35rem; }
  }
</style>
