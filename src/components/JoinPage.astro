<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ── pick a role ──
  const pick = document.querySelector<HTMLElement>('[data-pick]');
  if (pick) {
    const buttons = [...pick.querySelectorAll<HTMLButtonElement>('[data-role]')];
    const bun = pick.querySelector<HTMLElement>('[data-pick-bun]')!;
    const sayBox = pick.querySelector<HTMLElement>('.pick-say')!;
    const sayRole = pick.querySelector<HTMLElement>('[data-say-role]')!;
    const say = pick.querySelector<HTMLElement>('[data-say]')!;
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('li')!;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        bun.dataset.role = button.dataset.role;
        bun.classList.add('is-on');
        sayRole.textContent = `${item.querySelector('[data-name]')?.textContent ?? ''} · ${item.querySelector('[data-real]')?.textContent ?? ''}`;
        sayRole.hidden = false;
        say.textContent = item.querySelector('[data-line]')?.textContent ?? '';
        if (calm.matches) return;
        sayBox.classList.remove('is-new');
        void sayBox.offsetWidth;
        sayBox.classList.add('is-new');
        bun.animate?.(
          [
            { translate: '0 0', rotate: '0deg' },
            { translate: '0 -26px', rotate: '-8deg', offset: 0.35 },
            { translate: '0 0', rotate: '6deg', offset: 0.7 },
            { translate: '0 0', rotate: '0deg' },
          ],
          { duration: 520, easing: 'ease-in-out' },
        );
      });
      button.disabled = false;
    });
  }

  // ── a trail: draws the path through the tokens and hops the bun from one to another ──
  type Point = { x: number; y: number };
  const makeTrail = (root: HTMLElement) => {
    const bun = root.querySelector<HTMLElement>('[data-trail-bun]')!;
    const stops = [...root.querySelectorAll<HTMLElement>('[data-stop]')];
    const nodes = stops.map((stop) => stop.querySelector<HTMLElement>('[data-node]')!);
    const tokens = stops.map((stop) => stop.querySelector<HTMLButtonElement>('[data-token]')!);
    const roads = [...root.querySelectorAll<SVGPathElement>('[data-road]')];
    let pos = 0;
    let frame = 0;
    let at: Point = { x: 0, y: 0 };

    const centre = (i: number): Point => {
      const box = root.getBoundingClientRect();
      const r = nodes[i].getBoundingClientRect();
      return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
    };
    // where the bun stands for a stop: on top of its token
    const spot = (i: number): Point => {
      const c = centre(i);
      return { x: c.x - bun.offsetWidth / 2, y: c.y - nodes[i].offsetHeight / 2 - bun.offsetHeight + 10 };
    };
    const put = (p: Point) => { at = p; bun.style.translate = `${p.x.toFixed(1)}px ${p.y.toFixed(1)}px`; };

    const draw = () => {
      const pts = stops.map((_, i) => centre(i));
      const get = (i: number) => pts[Math.max(0, Math.min(pts.length - 1, i))];
      const n = (v: number) => v.toFixed(1);
      let d = `M${n(pts[0].x)} ${n(pts[0].y)}`;
      for (let i = 0; i < pts.length - 1; i += 1) {
        const [a, b, c, e] = [get(i - 1), get(i), get(i + 1), get(i + 2)];
        d += `C${n(b.x + (c.x - a.x) / 6)} ${n(b.y + (c.y - a.y) / 6)} ${n(c.x - (e.x - b.x) / 6)} ${n(c.y - (e.y - b.y) / 6)} ${n(c.x)} ${n(c.y)}`;
      }
      roads.forEach((road) => road.setAttribute('d', d));
    };

    const go = (to: number, landed?: () => void) => {
      window.cancelAnimationFrame(frame);
      const from = at;
      const end = spot(to);
      pos = to;
      const far = Math.hypot(end.x - from.x, end.y - from.y);
      if (calm.matches || far < 2) { put(end); landed?.(); return; }
      const duration = Math.min(1100, Math.max(420, far * 1.7));
      const jumps = Math.max(1, Math.round(far / 150));
      let start = 0;
      const step = (now: number) => {
        start ||= now;
        const t = Math.min(1, (now - start) / duration);
        const ease = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
        put({ x: from.x + (end.x - from.x) * ease, y: from.y + (end.y - from.y) * ease - Math.abs(Math.sin(Math.PI * t * jumps)) * 28 });
        if (t < 1) { frame = window.requestAnimationFrame(step); return; }
        put(end);
        landed?.();
      };
      frame = window.requestAnimationFrame(step);
    };

    const burst = (count: number) => {
      if (calm.matches) return;
      const colours = ['var(--lime)', 'var(--yellow)', 'var(--blue)', 'var(--purple)', 'var(--coral)', '#fff'];
      const box = bun.getBoundingClientRect();
      const cx = box.left + box.width / 2;
      const roomLeft = cx - 16;
      const roomRight = document.documentElement.clientWidth - cx - 16;
      for (let i = 0; i < count; i += 1) {
        const bit = document.createElement('span');
        const angle = Math.random() * Math.PI * 2;
        const far = 60 + Math.random() * 120;
        bit.className = i % 3 ? 'bit' : 'bit is-round';
        bit.style.setProperty('--c', colours[i % colours.length]);
        bit.style.setProperty('--dx', `${Math.max(-roomLeft, Math.min(roomRight, Math.cos(angle) * far)).toFixed(0)}px`);
        bit.style.setProperty('--dy', `${(Math.sin(angle) * far * 0.8 - 50).toFixed(0)}px`);
        bit.style.setProperty('--r', `${(Math.random() * 360 - 180).toFixed(0)}deg`);
        bit.style.setProperty('--t', `${(1 + Math.random() * 0.6).toFixed(2)}s`);
        bit.addEventListener('animationend', () => bit.remove());
        bun.append(bit);
      }
    };

    // the trail changes shape with the window: redraw the path and stand the bun back on its stop
    const settle = () => { window.cancelAnimationFrame(frame); draw(); put(spot(pos)); };
    settle();
    if ('ResizeObserver' in window) new ResizeObserver(settle).observe(root);
    root.classList.add('is-ready');
    tokens.forEach((token) => { token.disabled = false; });
    return { stops, tokens, go, burst };
  };

  // ── how we work: press a stop (or, on a narrow screen, scroll to it) and the bun goes there ──
  const work = document.querySelector<HTMLElement>('[data-trail="work"]');
  if (work) {
    const trail = makeTrail(work);
    let current = 0;
    const bun = work.querySelector<HTMLElement>('[data-trail-bun]')!;
    const select = (i: number) => {
      if (i === current) return;
      current = i;
      trail.stops.forEach((stop, n) => {
        stop.classList.toggle('is-current', n === i);
        if (n === i) trail.tokens[n].setAttribute('aria-current', 'true');
        else trail.tokens[n].removeAttribute('aria-current');
      });
      // the new outfit goes on when the bun lands
      trail.go(i, () => { bun.dataset.suit = String(i + 1); trail.burst(8); });
    };
    trail.stops.forEach((stop, i) => {
      trail.tokens[i].addEventListener('click', () => select(i));
      stop.querySelector('.bubble')?.addEventListener('click', () => {
        if (!window.getSelection()?.toString()) select(i);
      });
    });
    const narrow = window.matchMedia('(max-width: 1100px)');
    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (!narrow.matches) return;
          entries.forEach((entry) => { if (entry.isIntersecting) select(trail.stops.indexOf(entry.target as HTMLElement)); });
        },
        { rootMargin: '-45% 0px -45% 0px' },
      );
      trail.stops.forEach((stop) => seen.observe(stop));
    }
  }

  // ── do we suit each other: every tick turns one more chair round. Nothing is stored or sent. ──
  const fit = document.querySelector<HTMLElement>('[data-fit]');
  if (fit) {
    const game = fit.querySelector<HTMLElement>('.fit-game')!;
    const boxes = [...fit.querySelectorAll<HTMLInputElement>('[data-crit]')];
    const chairs = [...fit.querySelectorAll<HTMLElement>('[data-chair]')];
    const score = fit.querySelector<HTMLElement>('[data-score]')!;
    const win = fit.querySelector<HTMLElement>('[data-win]')!;
    const goBtn = fit.querySelector<HTMLElement>('[data-fit-go]')!;
    const total = boxes.length;
    // most of them is enough: nobody has to tick every one
    const enough = Math.max(1, total - 1);
    const render = () => {
      const n = boxes.filter((box) => box.checked).length;
      chairs.forEach((chair, i) => chair.classList.toggle('is-on', i < n));
      score.textContent = (fit.dataset.scoreText ?? '').replace('{n}', String(n)).replace('{total}', String(total));
      const won = n >= enough;
      game.classList.toggle('is-won', won);
      win.hidden = !won;
      goBtn.hidden = !won;
    };
    boxes.forEach((box) => box.addEventListener('change', render));
    render();
  }

  // ── copy a WeChat ID: each card's button copies the ID next to it ──
  const copyMsg = document.querySelector<HTMLElement>('[data-copy-msg]');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((copy) => {
    const idEl = copy.closest('[data-copy-from]')?.querySelector<HTMLElement>('[data-copy-text]');
    if (!idEl) return;
    const label = copy.querySelector<HTMLElement>('[data-copy-label]')!;
    const idle = label.textContent ?? '';
    let timer = 0;
    copy.addEventListener('click', async () => {
      const id = idEl.textContent?.trim() ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(id);
        ok = true;
      } catch {
        // no clipboard access (an old browser, or a page not served over https): try the old way
        const range = document.createRange();
        range.selectNodeContents(idEl);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        if (ok) window.getSelection()?.removeAllRanges();
      }
      window.clearTimeout(timer);
      copy.classList.toggle('is-copied', ok);
      label.textContent = ok ? copy.dataset.copied ?? idle : idle;
      if (copyMsg) copyMsg.textContent = ok ? '' : copy.dataset.fail ?? '';
      if (ok) timer = window.setTimeout(() => { copy.classList.remove('is-copied'); label.textContent = idle; }, 2200);
    });
  });
</script>
