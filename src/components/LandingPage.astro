---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Bun from './Bun.astro';
import UserVoices from './UserVoices.astro';
import XhsStrip from './XhsStrip.astro';
import { wechatId } from '../data/contact';
import { ui, defaultLocale } from '../i18n/landing';
import type { Lang, TranslationKey } from '../i18n/landing';

const locale = (Astro.currentLocale ?? defaultLocale) as Lang;
const getTranslation = (key: string): string | undefined =>
  (ui[locale] as Record<string, string | undefined>)[key] ??
  (ui[defaultLocale] as Record<string, string | undefined>)[key];
const t = (key: TranslationKey): string =>
  getTranslation(key) ?? '';

const seo = locale === 'zh'
  ? {
      title: 'BlotzTask 官方网站 | ADHD 任务管理 App 与 AI 待办事项工具',
      description: 'BlotzTask 官方网站。BlotzTask 是 ADHD 友好的 AI 任务管理 App，支持语音创建待办事项、AI 任务拆解、截止日期提醒和成果回顾，帮助你更轻松地开始任务。',
    }
  : {
      title: 'BlotzTask Official Website | ADHD Task Management App',
      description: 'Official website for BlotzTask, an ADHD-friendly AI task management app for voice capture, task breakdown, deadline tracking, and calmer planning.',
    };



const faqEntries = ([1,2,3,4,5,6] as const)
  .map((n) => ({
    question: getTranslation(`faq-q${n}`),
    answer: getTranslation(`faq-a${n}`),
  }))
  .filter((item): item is { question: string; answer: string } =>
    Boolean(item.question?.trim() && item.answer?.trim())
  );

const faqItems = faqEntries.map((item) => ({
  '@type': 'Question',
  name: item.question,
  acceptedAnswer: {
    '@type': 'Answer',
    text: item.answer,
  },
}));

const siteUrl = 'https://www.blotztask.com/';
const organizationId = 'https://www.blotztask.com/#organization';
const websiteId = 'https://www.blotztask.com/#website';
const appId = 'https://www.blotztask.com/#app';
const appStoreUrl = 'https://apps.apple.com/au/app/blotztask-adhd-time-manager/id6752492404';
const googlePlayUrl = 'https://play.google.com/store/apps/details?id=com.blotz.blotztask&hl=en';

const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: 'BlotzTask',
    alternateName: ['Blotz Task', 'BlotzTask official website'],
    url: siteUrl,
    publisher: { '@id': organizationId },
    inLanguage: ['en', 'zh'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: 'BlotzTask',
    alternateName: ['Blotz Task', 'Blotz'],
    url: siteUrl,
    logo: 'https://www.blotztask.com/shared-pic/bun-icon.png',
    sameAs: [
      appStoreUrl,
      googlePlayUrl,
      'https://www.instagram.com/blotztask.app/',
      'https://www.linkedin.com/company/blotz-app/',
      'https://www.xiaohongshu.com/user/profile/67bc12d6000000000e01f09a',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': ['SoftwareApplication', 'MobileApplication'],
    '@id': appId,
    name: 'BlotzTask',
    alternateName: ['Blotz Task', 'BlotzTask ADHD time manager'],
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'iOS, Android',
    publisher: { '@id': organizationId },
    description: seo.description,
    url: siteUrl,
    mainEntityOfPage: pageUrl,
    sameAs: [appStoreUrl, googlePlayUrl],
    downloadUrl: [appStoreUrl, googlePlayUrl],
    keywords: locale === 'zh'
      ? 'ADHD 任务管理 App, AI 任务管理, ADHD 待办事项 App, 任务拆解 App, 截止日期提醒'
      : 'ADHD task management app, AI task management, ADHD to-do app, task breakdown app, deadline reminder app',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems,
  },
];

const zh = locale === 'zh';
// The English page plays recordings made with the app in English (17 Oct).
const englishTakes = new Set(['voice', 'breakdown', 'gashapon', 'voice-done', 'breakdown-task', 'breakdown-steps', 'gashapon-machine', 'review-letter']);
const take = (name: string) => (!zh && englishTakes.has(name) ? `${name}-en` : name);

type Step = [number, string];

// Words for this page. Text inside [ ] gets the highlighter.
const home = zh
  ? {
      users: '2,800+ 人已注册',
      usersNum: '2,800+',
      usersLabel: '人已注册',
      title: '你的 [AI 生活规划师]',
      sub: 'BlotzTask 是一款为 ADHD 用户设计的 AI 任务管理 App。你可以用语音记下要做的事，AI 会把大任务拆成小步骤，并在截止日期前提醒你。',
      shots: ['BlotzTask 的今日任务页面，「准备雅思考试」已经拆成五个小步骤', 'BlotzTask 的语音输入页面'],
      heroShot: '/app/still-breakdown-steps.jpg',
      chipSaid: '「周三晚上准备雅思」',
      chipSplit: 'AI 拆成了 5 小步',
      chipRemind: '准备雅思考试',
      chipRemindWhen: '今晚 22:00 截止',
      weekTitle: '看看小包子的[一周]',
      stops: [
        { kind: 'intro', tone: 'paper', day: '周日', clock: '22:30', where: '躺在床上', sticker: '小包子', title: '小包子三周后[要考雅思]', said: '', arrow: '', caption: '脑子里还转着一堆别的事。下面是她接下来一周怎么用 BlotzTask。', note: '', pills: ['雅思还没开始准备', '妈妈后天到', '书一页都没读'], steps: [] as Step[], alt: '' },
        { kind: 'voice', tone: 'lime', day: '周一', clock: '08:10', where: '上班路上', sticker: 'AI 语音', title: '用丝滑的语音[几秒内变成任务]', said: '「明天下午三点去机场接妈妈。」', arrow: 'AI 把它变成一条任务', caption: '走在路上想起接妈妈的事还没记下来。腾不出手打字，她按住说了一句。', note: '', steps: [[0, '按住说话'], [6.4, 'AI 正在整理'], [9.2, '时间和日期都填好了']] as Step[], alt: '在 BlotzTask 里说一句话，AI 把它变成一条带时间的任务' },
        { kind: 'breakdown', tone: 'blue', day: '周三', clock: '20:00', where: '书桌前', sticker: 'AI 拆解', title: '大任务[拆成小步骤]', said: '', arrow: '', caption: '「准备雅思考试」太大，她不知道从哪开始。在任务上向左滑，AI 把它拆成五步，第一步只要五分钟。', note: '每一步都写了要多久', steps: [[0, '在任务上向左滑'], [2.6, '点 Breakdown'], [4.8, 'AI 拆成五个小步骤'], [8.5, '做完一步，勾一步']] as Step[], alt: '在 BlotzTask 里把「准备雅思考试」拆成五个带时间的小步骤' },
        { kind: 'badge', tone: 'paper', day: '周五', clock: '18:00', where: '下班路上', sticker: '成就徽章', title: '做完一点，[解锁徽章]', said: '', arrow: '', caption: '下班路上她勾掉今天最后一件事，掉出一枚新徽章。做完任务会随机掉徽章，做得越多，掉得越多。先攒着，以后能拿去换东西，换什么现在不说。', note: '', steps: [] as Step[], alt: 'BlotzTask 里解锁了一枚「星际漫游者」徽章' },
        { kind: 'gashapon', tone: 'purple', day: '周六', clock: '15:30', where: '沙发上', sticker: '扭蛋机', title: '选不出来，就[抽一件]', said: '', arrow: '', caption: '随手记里攒了六件小事，她挑不出先做哪件。转了一下扭蛋机，抽到「读十页书」。', note: '', steps: [[0, '打开扭蛋机'], [3.3, '转一下旋钮'], [6, '抽出一条随手记'], [10.1, '点「立即执行」，它就进了今天的任务']] as Step[], alt: '在 BlotzTask 里转动扭蛋机，抽出「读十页书」并开始执行' },
        { kind: 'review', tone: 'yellow', day: '周日', clock: '21:00', where: '睡前', sticker: 'AI 回顾', title: '每周、每月，[收到包子给你的信]', said: '', arrow: '', caption: '一周过完，睡前她打开回顾。包子照着她这周记的任务，给她写了一封信，可以导出成图片，发给朋友或者自己留着。', note: '', steps: [] as Step[], alt: '在 BlotzTask 里打开包子写的每周回顾信' },
        { kind: 'more', tone: 'paper', day: '之后', clock: '每一天', where: '随时', sticker: '更多场景', title: '还有哪些时候，[适合用包子]？', said: '', arrow: '', caption: '', note: '', steps: [] as Step[], alt: '', moments: [
          { q: '想早点睡，却总是熬夜', a: '设一个每天重复的「早点睡」任务，到点提醒你，睡了就打个卡。每个月包子会给你写一封信，告诉你这个月哪几天早睡了。' },
          { q: '要写毕业论文，却一直没动手', a: 'AI 会把一件大事拆成几个可以马上做的小步骤。' },
          { q: '一坐下学习，就想拿手机', a: '给这件任务开一个番茄钟，配上白噪音，先专心做完这一段。' },
          { q: '好几门作业同一周截止', a: '有截止日期的任务都在截止清单里。把最急的那件置顶，先做它。' },
        ] },
      ],
      extrasTitle: 'App 里[还有这些]',
      extras: [
        { icon: 'lucide:timer', title: '番茄钟', desc: '给一件任务开始专注计时，可以搭配白噪音。' },
        { icon: 'lucide:tags', title: '标签', desc: '给任务打上标签，比如工作、生活、学习。' },
        { icon: 'lucide:flag', title: '截止清单', desc: '有截止日期的任务集中在一个清单里，最要紧的可以置顶。' },
        { icon: 'lucide:notebook-pen', title: '随手记', desc: '想法先记下来，需要时再变成任务。' },
        { icon: 'lucide:repeat', title: '重复任务', desc: '每天、每周要做的事设定一次，之后会自动出现。' },
        { icon: 'lucide:calendar-days', title: '日历', desc: '可以看今天要做什么，也可以看整个月的安排。' },
      ],
      faqTitle: '[常见问题]',
      fanPill: '抢先测试新功能',
      fanPillGo: '加入粉丝团',
      apkAsk: '安卓手机用不了 Google Play？',
      apkAnswer: '加我们微信，我们把安装包直接发给你。',
      apkLabel: '微信号',
    }
  : {
      users: '2,800+ people have signed up',
      usersNum: '2,800+',
      usersLabel: 'signed up',
      title: 'Your [AI life planner]',
      sub: 'BlotzTask is an AI task app designed for people with ADHD. Record a task by voice, let AI break a big task into small steps, and get reminded before a deadline.',
      shots: ['The BlotzTask Today screen', 'The BlotzTask voice input screen'],
      heroShot: '/app/today.jpg',
      chipSaid: '“Gym after work tomorrow”',
      chipSplit: 'AI split it into small steps',
      chipRemind: 'Do exercise',
      chipRemindWhen: 'Due today at 18:59',
      weekTitle: 'A look at [Blotz’s week]',
      stops: [
        { kind: 'intro', tone: 'paper', day: 'Sunday', clock: '22:30', where: 'In bed', sticker: 'Blotz', title: 'Blotz sits IELTS [in three weeks]', said: '', arrow: '', caption: 'A pile of other things is going round her head too. This is how she uses BlotzTask over the next week.', note: '', pills: ['IELTS prep not started', 'Mum lands on Tuesday', 'The balcony plants need water'], steps: [] as Step[], alt: '' },
        { kind: 'voice', tone: 'lime', day: 'Monday', clock: '08:10', where: 'Walking to work', sticker: 'AI voice', title: 'Smooth voice input, [a task in seconds]', said: '"Pick up Mum from the airport at 3 pm tomorrow."', arrow: 'AI turns it into a task right away', caption: 'On the way to work she remembers she never wrote down picking Mum up. No free hand to type, so she holds the button and says it.', note: '', steps: [[0, 'Hold to talk'], [7, 'AI sorts it out'], [12, 'The time and date are filled in']] as Step[], alt: 'A sentence spoken into BlotzTask becomes a task with a time' },
        { kind: 'breakdown', tone: 'blue', day: 'Wednesday', clock: '20:00', where: 'At her desk', sticker: 'AI breakdown', title: 'A big task, [in small steps]', said: '', arrow: '', caption: '"Prepare for IELTS" is too big and she does not know where to start. She swipes left on the task and AI splits it into four steps. The first one takes five minutes.', note: 'Every step says how long it takes', steps: [[0, 'Swipe left on a task'], [2.6, 'Tap Breakdown'], [7, 'AI splits it into four steps'], [10.6, 'Tick off a step when it is done']] as Step[], alt: 'BlotzTask splitting "Prepare for IELTS" into four timed steps' },
        { kind: 'badge', tone: 'paper', day: 'Friday', clock: '18:00', where: 'On the way home', sticker: 'Badges', title: 'Finish a little, [unlock a badge]', said: '', arrow: '', caption: 'On the way home she ticks off today\'s last task and gets a new badge. Badges drop at random when tasks get done, and more tasks mean more badges. Keep them. Later they can be traded for something, and we are not saying what yet.', note: '', steps: [] as Step[], alt: 'A badge being unlocked in BlotzTask' },
        { kind: 'gashapon', tone: 'purple', day: 'Saturday', clock: '15:30', where: 'On the sofa', sticker: 'Gashapon', title: 'Cannot pick one? [Draw one]', said: '', arrow: '', caption: 'Five small things are waiting in Quick Notes and she cannot pick one, so she turns the capsule machine. It draws "water the plants on the balcony".', note: '', steps: [[0, 'Open the capsule machine'], [2.2, 'Turn the knob'], [8.6, 'It draws one of her notes']] as Step[], alt: 'Turning the capsule machine in BlotzTask draws "water the plants on the balcony"' },
        { kind: 'review', tone: 'yellow', day: 'Sunday', clock: '21:00', where: 'Before bed', sticker: 'AI review', title: 'Every week and month, [a letter from Blotz]', said: '', arrow: '', caption: 'The week is over. Before bed she opens Review, and Blotz has written her a letter from this week\'s tasks. She can export it as an image to keep or send to a friend.', note: '', steps: [] as Step[], alt: 'Opening the weekly review letter from Blotz in BlotzTask' },
        { kind: 'more', tone: 'paper', day: 'After that', clock: 'Any day', where: 'Anywhere', sticker: 'More moments', title: 'When else [is Blotz handy]?', said: '', arrow: '', caption: '', note: '', steps: [] as Step[], alt: '', moments: [
          { q: 'You want an early night, but you always stay up late', a: 'Set a daily "sleep early" task. It reminds you at bedtime, and you tick it off when you go to sleep. Every month Blotz writes you a letter saying which nights you made it.' },
          { q: 'A thesis to write, and you still have not started', a: 'AI splits one big job into small steps you can start right away.' },
          { q: 'You sit down to study and reach for your phone', a: 'Start a focus timer on the task, add white noise, and get through this one stretch first.' },
          { q: 'Three assignments due in the same week', a: 'Tasks with a deadline sit together in the deadline list. Pin the most urgent one and do it first.' },
        ] },
      ],
      extrasTitle: 'Also [in the app]',
      extras: [
        { icon: 'lucide:timer', title: 'Focus timer', desc: 'Start a focus session on a task, with white noise if you like.' },
        { icon: 'lucide:tags', title: 'Tags', desc: 'Give tasks a tag such as Work, Life or Learning.' },
        { icon: 'lucide:flag', title: 'Deadline list', desc: 'Tasks with a deadline sit together in one list, and you can pin the most urgent one.' },
        { icon: 'lucide:notebook-pen', title: 'Quick Notes', desc: 'Write an idea down first and turn it into a task when you need to.' },
        { icon: 'lucide:repeat', title: 'Repeating tasks', desc: 'Set up a daily or weekly task once and it comes back by itself.' },
        { icon: 'lucide:calendar-days', title: 'Calendar', desc: 'See what is on today, or look at the whole month.' },
      ],
      faqTitle: '[Questions]',
      fanPill: 'Test new features first',
      fanPillGo: 'Join',
      apkAsk: 'On Android without Google Play?',
      apkAnswer: 'Add us on WeChat and we will send you the install file.',
      apkLabel: 'WeChat ID',
    };

// "普通[高亮]普通" -> parts; odd parts get the highlighter.
const hl = (text: string) => text.split(/\[|\]/);
const stickerTone: Record<string, string> = { lime: '', paper: '', blue: 'is-blue', yellow: 'is-yellow', purple: 'is-purple' };
const bars = [10, 18, 26, 14, 22, 30, 16, 24, 12, 20, 28, 15, 9, 19, 25, 13];
---

<Layout
  title={seo.title}
  description={seo.description}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="band band-top hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="hero-pills">
          <!-- the fan group, kept small up here; the whole thing lives on /fans -->
          <a class="fan-pill" href={`/${locale}/fans`}>
            <span class="fan-pill-buns" aria-hidden="true">
              <Bun face="grin" tone="pink" class="fan-bun" />
              <Bun face="happy" tone="sky" class="fan-bun" />
              <Bun face="wink" tone="lilac" class="fan-bun" />
            </span>
            <span>{home.fanPill}</span>
            <span class="fan-pill-go">{home.fanPillGo}<Icon name="lucide:arrow-right" width={15} height={15} /></span>
          </a>
        </div>
        <h1 class="k-h1">{hl(home.title).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h1>
        <p class="k-lead">{home.sub}</p>
        <!-- every "download" link on the site lands here -->
        <div class="k-btn-row" id="download">
          <a class="k-btn is-ink" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="simple-icons:apple" width={20} height={20} />
            App Store
          </a>
          <a class="k-btn" href={googlePlayUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="simple-icons:googleplay" width={18} height={18} />
            Google Play
          </a>
        </div>
        <!-- for people who have neither store: opens in place, no pop-up -->
        <details class="apk">
          <summary>
            <Icon name="simple-icons:wechat" width={20} height={20} />
            <span>{home.apkAsk}</span>
            <span class="apk-chev"><Icon name="lucide:chevron-down" width={16} height={16} /></span>
          </summary>
          <div class="apk-body">
            <p>{home.apkAnswer}</p>
            <p class="apk-id"><span>{home.apkLabel}</span><strong>{wechatId}</strong></p>
          </div>
        </details>
      </div>
      <!-- the phone on a round colour stage, the bun peeking over its top, what the app just did floating around it -->
      <div class="hero-art">
        <span class="hero-stage" aria-hidden="true"></span>
        <!-- the sign-up count as a milestone medal hanging off the stage -->
        <div class="hero-medal" role="img" aria-label={home.users}>
          <span class="medal-tails" aria-hidden="true"><i></i><i></i></span>
          <span class="medal-face" aria-hidden="true">
            <Icon name="lucide:users" width={18} height={18} />
            <b>{home.usersNum}</b>
            <small>{home.usersLabel}</small>
          </span>
        </div>
        <Bun face="plain" class="hero-peek" />
        <div class="k-phone hero-phone"><img src={home.heroShot} alt={home.shots[0]} width="590" height="1282" /></div>
        <div class="hero-chip chip-said" aria-hidden="true">
          <span class="chip-mic"><Icon name="lucide:mic" width={16} height={16} /></span>
          <span class="chip-wave"><i></i><i></i><i></i><i></i><i></i></span>
          <span>{home.chipSaid}</span>
        </div>
        <div class="hero-chip chip-split" aria-hidden="true">
          <Icon name="lucide:sparkles" width={18} height={18} />
          <span>{home.chipSplit}</span>
        </div>
        <div class="hero-chip chip-remind" aria-hidden="true">
          <img src="/app/icon.png" alt="" width="34" height="34" />
          <span class="chip-remind-text"><b>{home.chipRemind}</b><small>{home.chipRemindWhen}</small></span>
        </div>
        <Bun face="wink" tone="pink" class="hero-bun bun-pink" />
        <Bun face="smile" tone="sky" class="hero-bun bun-sky" />
        <Bun face="happy" tone="lilac" class="hero-bun bun-lilac" />
      </div>
    </div>
  </section>

  <!-- FEATURES: one person's week. Each stop on the trail is a moment that needs one feature. -->
  <section class="band week-head" id="features">
    <div class="wrap k-page-head reveal">
      <h2 class="k-h2">{hl(home.weekTitle).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h2>
    </div>
  </section>
  <div class="trail">
    {home.stops.map((stop) => {
      const heading = (
        <>
          <span class:list={['k-sticker', stickerTone[stop.tone]]}>{stop.sticker}</span>
          <h3 class="k-h2 stop-h">{hl(stop.title).map((part, j) => (j % 2 ? <span class="k-hl">{part}</span> : part))}</h3>
        </>
      );
      // a window onto part of the phone recording, with the caption bar under it
      const clip = (name: string, still: string, y: number, h: number, shown = 0) => (
        <div class="frame clipbox" data-stage>
          <div class="crop" style={`--y:${y};--h:${h}`}>
            <video
              class="scene-video"
              src={`/app/clip-${take(name)}.mp4`}
              poster={`/app/still-${take(still)}.jpg`}
              aria-label={stop.alt}
              data-steps={JSON.stringify(stop.steps)}
              data-shown={shown}
              width="590" height="1282"
              muted loop playsinline preload="none"
            ></video>
          </div>
          <div class="third" aria-hidden="true">
            <span data-step-text>{stop.steps[shown]?.[1]}</span>
          </div>
        </div>
      );
      return (
        <section class:list={['band', 'stop', stop.tone !== 'paper' && `band-${stop.tone}`]}>
          <div class="wrap stop-grid">
            <div class="when"><span class="day">{stop.day}</span><span class="clock">{stop.clock}</span><span class="where">{stop.where}</span></div>

            {stop.kind === 'intro' && (
              <div class="stop-body s-two reveal">
                <div class="stop-text">{heading}<p class="k-lead">{stop.caption}</p></div>
                <div class="s-intro-art" aria-hidden="true">
                  <Bun face="teary" class="s-intro-bun" />
