  <script>
    // Each recording plays only while it is on screen. With reduced motion it stays on its still image.
    // Watch the window the recording shows through, not the video: only a strip of the video shows, so the
    // video itself is never half on screen when the strip is short (the voice and breakdown clips never started).
    const clips = Array.from(document.querySelectorAll('.scene-video')) as HTMLVideoElement[];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!still && 'IntersectionObserver' in window) {
      const watcher = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const clip = entry.target.querySelector('.scene-video') as HTMLVideoElement;
          if (entry.isIntersecting) clip.play().catch(() => {});
          else clip.pause();
        });
      }, { threshold: 0.5 });
      clips.forEach((clip) => watcher.observe(clip.parentElement as HTMLElement));
    }

    // The caption under each phone follows the recording: it names the step that is on screen.
    clips.forEach((clip) => {
      const stage = clip.closest('[data-stage]');
      const steps = JSON.parse(clip.dataset.steps ?? '[]') as [number, string][];
      const text = stage?.querySelector('[data-step-text]');
      if (!text || !steps.length) return;
      let shown = Number(clip.dataset.shown ?? 0);
      clip.addEventListener('timeupdate', () => {
        let current = 0;
        steps.forEach(([start], i) => { if (clip.currentTime >= start) current = i; });
        if (current === shown) return;
        shown = current;
        text.textContent = steps[current][1];
      });
    });
  </script>
