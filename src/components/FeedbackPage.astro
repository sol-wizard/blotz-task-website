---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale } from '../i18n/landing';
import Bun from './Bun.astro';
const locale = Astro.currentLocale ?? defaultLocale;
const zh = locale === 'zh';
const feedbackUrl = 'https://m3cetbcyp2d.usttp.larksuite.com/share/base/form/shrutCtpZYEZ0KeRokQpJ7K96rd';

// Where every feedback button lands (the footer and the last roadmap stop) while feedback is being
// moved into the app (roadmap stop 7). The form is the main way in for now.
// Text inside [ ] gets the highlighter.
const c = zh
  ? {
      seoTitle: '反馈功能升级中 | BlotzTask',
      seoDesc: 'BlotzTask 正在把反馈功能搬进 App 里。',
      sticker: '施工中',
      title: '反馈功能[正在升级]',
      sub: '我们正在把反馈搬进 App 里，以后不用离开 App，就能匿名发反馈和截图。',
      roadmap: '去路线图看进度',
      form: '先用表单告诉我们',
    }
  : {
      seoTitle: 'Feedback is being upgraded | BlotzTask',
      seoDesc: 'BlotzTask is moving feedback into the app.',
      sticker: 'Under construction',
      title: 'Feedback is [being upgraded]',
      sub: 'We are moving feedback into the app. Soon you can send anonymous feedback with a screenshot without leaving it.',
      roadmap: 'See progress on the roadmap',
      form: 'Tell us with the form for now',
    };
const hl = (text: string) => text.split(/\[|\]/);
---

<Layout title={c.seoTitle} description={c.seoDesc} noindex>
  <section class="band band-top band-yellow fb">
    <div class="wrap fb-inner">
      <div class="fb-art" aria-hidden="true">
        <span class="fb-cone fb-cone-l"></span>
        <Bun face="grin" tone="lime" class="fb-bun" />
        <span class="fb-hat"></span>
        <span class="fb-cone fb-cone-r"></span>
        <span class="fb-tape"></span>
      </div>
      <span class="k-sticker is-yellow"><Icon name="lucide:hard-hat" width={16} height={16} />{c.sticker}</span>
      <h1 class="k-h1">{hl(c.title).map((part, i) => (i % 2 ? <span class="k-hl">{part}</span> : part))}</h1>
      <p class="k-lead">{c.sub}</p>
      <div class="k-btn-row">
        <a class="k-btn is-ink" href={feedbackUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="lucide:message-square-plus" width={20} height={20} />
          {c.form}
          <Icon name="lucide:arrow-up-right" width={18} height={18} />
        </a>
      </div>
      <a class="fb-form" href={`/${locale}/roadmap`}>
        {c.roadmap}
        <Icon name="lucide:arrow-right" width={16} height={16} />
      </a>
    </div>
  </section>
</Layout>

<style>
  .fb { min-height: 82vh; display: flex; align-items: center; }
  .fb-inner { display: flex; flex-direction: column; align-items: center; gap: 1.3rem; text-align: center; }
  .fb-inner .k-lead { max-width: 38rem; }
  .fb-inner .k-btn-row { justify-content: center; margin-top: 0.4rem; }

  /* the bun in a hard hat, between two traffic cones, behind a strip of tape */
  .fb-art { position: relative; width: 260px; height: 170px; margin-bottom: 0.4rem; }
  .fb-art :global(.fb-bun) { position: absolute; left: 50%; bottom: 18px; width: 130px; margin-left: -65px; }
  .fb-hat {
    position: absolute; left: 50%; bottom: 112px; width: 84px; height: 40px; margin-left: -34px;
    border-radius: 42px 42px 6px 6px; border: 2px solid var(--ink); background: var(--yellow); transform: rotate(-8deg);
  }
  .fb-hat::after { content: ''; position: absolute; left: -10px; right: -10px; bottom: -6px; height: 8px; border-radius: 4px; border: 2px solid var(--ink); background: var(--yellow); }
  .fb-cone { position: absolute; bottom: 10px; width: 40px; height: 56px; clip-path: polygon(50% 0, 100% 100%, 0 100%);
    background: repeating-linear-gradient(to bottom, var(--coral) 0 12px, #fff 12px 20px); }
  .fb-cone-l { left: 6px; }
  .fb-cone-r { right: 6px; }
  .fb-tape { position: absolute; left: -10px; right: -10px; bottom: 30px; height: 18px; border: 2px solid var(--ink); transform: rotate(-4deg);
    background: repeating-linear-gradient(45deg, var(--yellow) 0 14px, var(--ink) 14px 26px); }

  .fb-form { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--muted); font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }
  .fb-form:hover { color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .fb-art :global(.fb-bun), .fb-hat { animation: fb-bob 3s ease-in-out infinite; }
  }
  @keyframes fb-bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }
</style>
