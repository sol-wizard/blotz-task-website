---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

type GuideSection = {
  title: string;
  body: string;
  points?: string[];
};

type GuideFaq = {
  question: string;
  answer: string;
};

interface Props {
  slug: string;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  sections: GuideSection[];
  faqs: GuideFaq[];
  related: { label: string; href: string }[];
}

const {
  slug,
  title,
  description,
  eyebrow,
  h1,
  intro,
  sections,
  faqs,
  related,
} = Astro.props;

const locale = Astro.currentLocale === 'zh' ? 'zh' : 'en';
const copy = locale === 'zh'
  ? {
      officialSite: 'BlotzTask 官方网站',
      download: '下载 BlotzTask',
      seeFeatures: '查看功能',
      contentLabel: '指南内容',
      faqTitle: '常见问题',
      relatedTitle: '相关 BlotzTask 指南',
    }
  : {
      officialSite: 'BlotzTask official site',
      download: 'Download BlotzTask',
      seeFeatures: 'See features',
      contentLabel: 'Guide content',
      faqTitle: 'Questions people ask about this',
      relatedTitle: 'Related BlotzTask guides',
    };
const canonical = `https://www.blotztask.com/${locale}/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    url: canonical,
    author: {
      '@type': 'Organization',
      name: 'BlotzTask',
      url: 'https://www.blotztask.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'BlotzTask',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.blotztask.com/shared-pic/bun-icon.png',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <main>
    <section class="band band-top band-lime">
      <div class="wrap guide-head">
        <a class="guide-back" href={`/${locale}/`}>
          <Icon name="lucide:arrow-left" width={18} height={18} />
          <span>{copy.officialSite}</span>
        </a>
        <span class="k-sticker">{eyebrow}</span>
        <h1 class="k-h1 guide-h1">{h1}</h1>
        <p class="k-lead">{intro}</p>
        <div class="k-btn-row">
          <a class="k-btn is-ink" href={`/${locale}/#download`}>{copy.download}</a>
          <a class="k-btn" href={`/${locale}/#features`}>{copy.seeFeatures}</a>
        </div>
      </div>
    </section>

    <section class="band" aria-label={copy.contentLabel}>
      <div class="wrap guide-sections">
        {sections.map((section) => (
          <article class="k-card guide-section reveal">
            <h2 class="k-h3 guide-h2">{section.title}</h2>
            <p>{section.body}</p>
            {section.points && (
              <ul>
                {section.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="band band-yellow" aria-labelledby="guide-faq-title">
      <div class="wrap k-faq">
        <h2 class="k-h2" id="guide-faq-title">{copy.faqTitle}</h2>
        <div class="k-faq-list">
          {faqs.map((item) => (
            <details class="k-faq-item">
              <summary>
                <span>{item.question}</span>
                <span class="k-faq-chev"><Icon name="lucide:chevron-down" width={18} height={18} /></span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-blue" aria-labelledby="guide-related-title">
      <div class="wrap">
        <h2 class="k-h2 k-center" id="guide-related-title">{copy.relatedTitle}</h2>
        <ul class="k-tiles guide-related" style={`--cols: ${Math.min(related.length, 3)}; --cols-md: 1;`}>
          {related.map((item) => (
            <li>
              <a class="k-card k-tile k-lift guide-related-link" href={item.href}>
                <span class="k-h3">{item.label}</span>
                <Icon name="lucide:arrow-right" width={20} height={20} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  .guide-head { display: flex; flex-direction: column; align-items: flex-start; gap: 1.3rem; }
  .guide-back { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--ink); text-decoration: none; font-weight: 900; }
  .guide-back:hover { text-decoration: underline; }
  .guide-h1 { font-size: clamp(2.1rem, 4.2vw, 3.6rem); }
  .guide-sections { display: flex; flex-direction: column; gap: 1.5rem; }
  .guide-section { padding: 2rem; }
  .guide-h2 { font-size: 1.6rem; margin-bottom: 0.75rem; }
  .guide-section p, .guide-section li { color: var(--muted); font-size: 1.12rem; line-height: 1.8; }
  .guide-section ul { margin: 0.9rem 0 0 1.3rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .guide-related { margin-top: 2.5rem; }
  .guide-related-link { flex-direction: row; align-items: center; justify-content: space-between; gap: 1rem; }
  @media (max-width: 900px) { .guide-head { align-items: flex-start; } }
</style>
