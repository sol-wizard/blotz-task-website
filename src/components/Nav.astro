---
import { Icon } from 'astro-icon/components';
import Bun from './Bun.astro';
import { ui, defaultLocale } from '../i18n/landing';
import type { Lang, TranslationKey } from '../i18n/landing';

const locale = (Astro.currentLocale ?? defaultLocale) as Lang;
const t = (key: TranslationKey): string =>
  (ui[locale] as typeof ui[typeof defaultLocale])[key] ?? ui[defaultLocale][key];

const pathname = Astro.url.pathname;
const isAbout = pathname.includes('/about');
const isRoadmap = pathname.includes('/roadmap');
const isJoin = pathname.includes('/join');
const isSponsor = pathname.includes('/sponsor');
const menuOpenLabel = locale === 'zh' ? '展开菜单' : 'Open navigation menu';
const menuCloseLabel = locale === 'zh' ? '收起菜单' : 'Close navigation menu';

const otherLocale: Lang = locale === 'zh' ? 'en' : 'zh';
const otherLocalePath = `/${otherLocale}${pathname.replace(/^\/(en|zh)(?=\/|$)/, '')}`;
const langSwitchAriaLabel = otherLocale === 'zh' ? 'Switch to Chinese' : '切换到英文';
// The language switch is a two-part pill. The language you are reading is lime with its bun
// (pink red-bean for 中文, custard for English); the other half is a plain link.
const langs = [
  { code: 'zh' as Lang, label: '中', tone: 'pink' as const, face: 'happy' as const },
  { code: 'en' as Lang, label: 'EN', tone: 'cream' as const, face: 'smile' as const },
];
---

<div class="nav-wrap">
  <nav class="nav">
    <a class="logo" href={`/${locale}/`}>
      <img class="logo-icon" src="/app/icon.png" alt="" width="40" height="40" />
      <span class="logo-word">BlotzTask</span>
    </a>

    <div class="nav-links">
      <a class:list={['nav-link', { active: isAbout }]} href={`/${locale}/about`}>{t('nav-about')}</a>
      <a class:list={['nav-link', { active: isRoadmap }]} href={`/${locale}/roadmap`}>{t('nav-roadmap')}</a>
      <a class:list={['nav-link', { active: isJoin }]} href={`/${locale}/join`}>{t('nav-join')}</a>
      <a class:list={['nav-link', { active: isSponsor }]} href={`/${locale}/sponsor`}>{t('nav-sponsor')}</a>
    </div>

    <div class="lang-toggle nav-lang" role="group" aria-label={locale === 'zh' ? '语言' : 'Language'}>
      {langs.map((l) => l.code === locale ? (
        <span class="lang-opt is-on" aria-current="true"><Bun face={l.face} tone={l.tone} class="lang-bun" /><b>{l.label}</b></span>
      ) : (
        <a class="lang-opt" href={otherLocalePath} aria-label={langSwitchAriaLabel} lang={l.code === 'zh' ? 'zh' : 'en'}><b>{l.label}</b></a>
      ))}
    </div>

    <a class="nav-cta" href={`/${locale}/#download`}>
      {t('nav-cta')}
    </a>

    <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={menuOpenLabel} data-open-label={menuOpenLabel} data-close-label={menuCloseLabel}>
      <Icon class="menu-icon menu-icon-open" name="lucide:menu" width={22} height={22} />
      <Icon class="menu-icon menu-icon-close" name="lucide:x" width={22} height={22} />
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert hidden>
    <div class="mobile-menu-section">
      <a class:list={['mobile-menu-link', { active: isAbout }]} href={`/${locale}/about`}>{t('nav-about')}</a>
      <a class:list={['mobile-menu-link', { active: isRoadmap }]} href={`/${locale}/roadmap`}>{t('nav-roadmap')}</a>
      <a class:list={['mobile-menu-link', { active: isJoin }]} href={`/${locale}/join`}>{t('nav-join')}</a>
      <a class:list={['mobile-menu-link', { active: isSponsor }]} href={`/${locale}/sponsor`}>{t('nav-sponsor')}</a>
      <div class="mobile-menu-lang">
        <div class="lang-toggle" role="group" aria-label={locale === 'zh' ? '语言' : 'Language'}>
          {langs.map((l) => l.code === locale ? (
            <span class="lang-opt is-on" aria-current="true"><Bun face={l.face} tone={l.tone} class="lang-bun" /><b>{l.label}</b></span>
          ) : (
            <a class="lang-opt" href={otherLocalePath} aria-label={langSwitchAriaLabel} lang={l.code === 'zh' ? 'zh' : 'en'}><b>{l.label}</b></a>
          ))}
        </div>
      </div>
      <a class="mobile-menu-cta" href={`/${locale}/#download`}>{t('nav-cta')}</a>
    </div>
  </div>
</div>

<style>
  /* White capsule with an ink outline, floating under the top edge */
  .nav-wrap {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; flex-direction: column; align-items: center;
    padding: 1rem 1.5rem; pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    width: 100%; max-width: min(1320px, 90vw);
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 1.25rem;
    border-radius: 999px; border: 2px solid var(--ink);
    background: #fff; box-shadow: 0 5px 0 0 var(--ink);
  }

  .logo { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; margin-right: auto; }
  /* the same mark as the app icon and the 小红书 profile picture */
  .logo-icon {
    display: block; width: 40px; height: 40px; flex-shrink: 0;
    border-radius: 22%; border: 2px solid var(--ink); background: #fff;
    transition: transform 0.28s cubic-bezier(.34, 1.56, .64, 1);
  }
  .logo:hover .logo-icon, .logo:focus-visible .logo-icon { transform: rotate(-8deg) scale(1.08); }
  .logo-word { font-weight: 900; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--ink); }

  .nav-links { display: flex; align-items: center; gap: 0.1rem; }
  .nav-link {
    padding: 0.45rem 0.95rem; border-radius: 999px; border: none; background: none;
    font: inherit; font-size: 1rem; font-weight: 800; color: var(--ink);
    text-decoration: none; cursor: pointer; white-space: nowrap;
    display: flex; align-items: center; gap: 0.3rem;
    transition: background 0.18s ease;
  }
  .nav-link:hover, .nav-link.active { background: var(--lime-soft); }
  .nav-link:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  .ddi-icon {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; flex-shrink: 0; border-radius: 10px;
    border: 2px solid var(--ink); background: var(--lime); color: var(--ink);
  }
  /* two-part pill: the language you are reading is lime with a bun, press the other half to switch */
  .lang-toggle { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px; border: 2px solid var(--ink); background: #fff; }
  .lang-opt {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem;
    height: 32px; min-width: 44px; padding: 0 0.8rem; border-radius: 999px;
    color: var(--muted); font-size: 0.92rem; font-weight: 900; line-height: 1; text-decoration: none; white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .lang-opt b { font-weight: 900; }
  a.lang-opt:hover { background: var(--lime-soft); color: var(--ink); }
  a.lang-opt:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .lang-opt.is-on { padding: 0 0.8rem 0 0.35rem; background: var(--lime); color: var(--ink); box-shadow: inset 0 0 0 2px var(--ink); }
  .lang-opt.is-on :global(.lang-bun) { width: 24px; transform: rotate(-8deg) translateY(-1px); animation: lang-bob 2.6s ease-in-out infinite; }
  @keyframes lang-bob { 0%, 100% { transform: rotate(-8deg) translateY(-1px); } 50% { transform: rotate(4deg) translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .lang-opt.is-on :global(.lang-bun) { animation: none; } }

  .nav-cta {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 1.15rem; border-radius: 999px; border: 2px solid var(--ink);
    font-weight: 900; font-size: 0.98rem; white-space: nowrap; text-decoration: none;
    color: var(--ink); background: var(--lime);
    transition: transform 0.15s ease;
  }
  .nav-cta:hover { transform: translateY(-1px); }
  .nav-cta:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  .mobile-menu-toggle, .mobile-menu { display: none; }

  @media (max-width: 1040px) {
    .nav-wrap { padding: 0.75rem 1rem; }
    .nav { max-width: 100%; padding: 0.4rem 0.45rem 0.4rem 1rem; }
    .logo-word { font-size: 1.08rem; }
    .nav-links, .nav-lang, .nav-cta { display: none; }
    .mobile-menu-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: 42px; height: 42px; flex: 0 0 42px;
      border-radius: 50%; border: 2px solid var(--ink); background: var(--lime); color: var(--ink);
      cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .mobile-menu-toggle:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
    .menu-icon { display: block; }
    .menu-icon-close { display: none; }
    .nav-wrap.menu-open .menu-icon-open { display: none; }
    .nav-wrap.menu-open .menu-icon-close { display: block; }
    .mobile-menu { pointer-events: auto; width: 100%; display: block; }
    .mobile-menu[hidden] { display: none; }
    .mobile-menu-section {
      margin-top: 0.7rem; padding: 0.7rem;
      border-radius: 22px; border: 2px solid var(--ink); background: #fff; box-shadow: 0 5px 0 0 var(--ink);
    }
    .mobile-menu-item, .mobile-menu-link, .mobile-menu-cta {
      display: flex; align-items: center; min-height: 48px; border-radius: 14px;
      color: var(--ink); font-size: 1.05rem; font-weight: 900; text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }
    .mobile-menu-item { gap: 0.75rem; padding: 0.45rem 0.55rem; }
    .mobile-menu-lang { display: flex; padding: 0.5rem 0.55rem; }
    .mobile-menu-lang .lang-opt { height: 38px; font-size: 1rem; padding: 0 1rem; }
    .mobile-menu-lang .lang-opt.is-on { padding: 0 1rem 0 0.4rem; }
    .mobile-menu-lang .lang-opt :global(.lang-bun) { width: 28px; }
    .mobile-menu-link { padding: 0.5rem 0.7rem; }
    .mobile-menu-link.active, .mobile-menu-item:hover, .mobile-menu-link:hover { background: var(--lime-soft); }
    .mobile-menu-cta { justify-content: center; margin-top: 0.5rem; border: 2px solid var(--ink); background: var(--lime); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-icon, .nav-link, .nav-cta { transition: none; }
    .logo:hover .logo-icon, .logo:focus-visible .logo-icon { transform: none; }
  }
</style>

<script>
  const wrap = document.querySelector('.nav-wrap') as HTMLElement;
  const menuButton = wrap?.querySelector('.mobile-menu-toggle') as HTMLButtonElement | null;
  const mobileMenu = wrap?.querySelector('.mobile-menu') as HTMLElement | null;

  const setMenuOpen = (isOpen: boolean) => {
    if (mobileMenu && isOpen) mobileMenu.hidden = false;
    wrap.classList.toggle('menu-open', isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
    menuButton?.setAttribute(
      'aria-label',
      isOpen
        ? menuButton.dataset.closeLabel ?? 'Close navigation menu'
        : menuButton.dataset.openLabel ?? 'Open navigation menu'
    );
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
    if (mobileMenu) mobileMenu.inert = !isOpen;
    if (mobileMenu && !isOpen) mobileMenu.hidden = true;
  };

  const onScroll = () => wrap.classList.toggle('scrolled', window.scrollY > 12);
  window.addEventListener('scroll', onScroll, { passive: true });
  menuButton?.addEventListener('click', () => {
    setMenuOpen(!wrap.classList.contains('menu-open'));
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  // Remember the language picked here, so the home page opens in it next time (see Layout.astro).
  wrap?.querySelectorAll<HTMLAnchorElement>('a.lang-opt').forEach((link) => {
    link.addEventListener('click', () => {
      try { localStorage.setItem('blotz-lang', link.lang); } catch {}
    });
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 1040) setMenuOpen(false);
  });
  onScroll();
</script>
